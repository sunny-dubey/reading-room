# Copy to .env (git-ignored) to turn on AI features locally. Never commit .env.
ANTHROPIC_API_KEY=
# api (Claude API, needs the key above) | cli (your local Claude Code, `claude` on PATH, uses your subscription)
# Leave unset to use the API if a key is set, otherwise the CLI.
AI_BACKEND=
# on (default) or off. `npm run edition -- --no-ai` also skips AI for one run.
AI_FEATURES=on
# Refuse any single AI request estimated above this many US dollars.
AI_MAX_USD_PER_RUN=0.5
