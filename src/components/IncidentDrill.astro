---
// Incident drill: a real outage, replayed one status update at a time. Write your hypothesis first.
import { checklist } from '../lib/puzzles';
import { fmtDuration, type Incident } from '../lib/outages';
interface Props { i: Incident }
const { i } = Astro.props;
const [first, ...rest] = i.updates;
const t = (ms: number) => new Date(ms).toISOString().slice(11, 16) + ' UTC';
const elapsed = (ms: number) => `+${fmtDuration(ms - first.at) || '0 min'}`;
---
<section class="drill" data-drill={i.id}>
    <h3 class="fp-box-h">Incident drill · you're on call</h3>
    <p class="drill-setup">A real incident at <b>{i.provider}</b> on {new Date(i.start).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' })}{i.places.length ? `, ${i.places.map(p => p.name).join(', ')}` : ''}. Here's the first thing anyone knew:</p>
    <div class="drill-first">
        <span class="drill-t">{t(first.at)} · {first.status}</span>
        <p>{i.title}. {first.text.length > 280 ? first.text.slice(0, 277) + '…' : first.text}</p>
    </div>
    <p class="drill-q">What's your first hypothesis, and what would you check? Think it through, then reveal what happened.</p>
    <details class="pz-hint"><summary>Stuck? First things to check</summary>
        <ul>{checklist(`${i.title} ${first.text}`).map(c => <li>{c}</li>)}</ul>
    </details>
    <ol class="drill-steps" role="list">
        {rest.map(up => (
            <li hidden data-drill-step>
                <span class="drill-t">{t(up.at)} · {elapsed(up.at)} · {up.status}</span>
                <p>{up.text.length > 360 ? up.text.slice(0, 357) + '…' : up.text}</p>
            </li>
        ))}
    </ol>
    <div class="drill-end" data-drill-end hidden>
        <p>{i.duration ? <b>Resolved after {fmtDuration(i.duration)}.</b> : <b>Resolved.</b>}{i.cause ? ` The stated cause: ${i.cause}` : ''}{i.identifiedAfter !== undefined ? ` Cause found after ${fmtDuration(i.identifiedAfter)}.` : ''} How close was your first hypothesis?</p>
        <p class="inc-links">
            <a href={i.url} target="_blank" rel="noopener noreferrer">The provider's status page →</a>
            {i.rca && <a class="inc-rca" href={i.rca.url} target="_blank" rel="noopener noreferrer">Postmortem: {i.rca.title} →</a>}
        </p>
    </div>
    <button type="button" class="pz-reveal" data-drill-next>Show the next update ({rest.length} left)</button>
</section>
