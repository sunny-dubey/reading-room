---
import { u } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
import { CATEGORIES } from '../lib/feeds';
const path = Astro.url.pathname.replace(/\/?$/, '/');
// One navigation: the six parts of the edition, in Sunny's priority order (2026-11-25). Every other page belongs
// to a part (so its part is highlighted there); desks and study pages are reached from Learn, the rest from the footer.
const PARTS = [
    { href: '/digest/', label: 'Summary', also: [] },
    { href: '/discover/', label: 'Discover', also: ['/startups/', '/big-tech/', '/communities/'] },
    { href: '/learn/', label: 'Learn', also: [...CATEGORIES.map(c => `/${c.slug}/`), '/roadmap/', '/canon/', '/week/', '/sources/', '/notebook/'] },
    { href: '/news/', label: 'News', also: ['/business/', '/briefing/', '/markets/', '/outages/', '/pulse/'] },
    { href: '/try/', label: 'Try it', also: ['/puzzles/'] },
    { href: '/papers/', label: 'Research', also: [] },
    { href: '/thoughts/', label: 'Thoughts', also: [] },
].map(p => ({ ...p, active: [p.href, ...p.also].some(h => path.startsWith(u(h))) }));
---
<div class="nav-wrap">
    <nav class="nav" aria-label="Primary">
        <a class="brand" href={u('/')}>
            <span class="brand-mark" aria-hidden="true">R</span>
            <span class="brand-name">The Reading Room</span>
        </a>
        <div class="nav-links">
            {PARTS.map(p => <a href={u(p.href)} aria-current={p.active ? 'page' : undefined}>{p.label}</a>)}
        </div>
        <div class="nav-tools">
            <a href={u('/search/')} class="icon-btn" aria-label="Search" title="Search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </a>
            <ThemeToggle />
        </div>
    </nav>
    {/* Phones: the same six parts as a scrollable row (the top bar's links are hidden there). */}
    <nav class="sections-bar parts-bar" aria-label="Parts">
        <a href={u('/')} aria-current={path === u('/').replace(/\/?$/, '/') ? 'page' : undefined}>Today</a>
        {PARTS.map(p => <a href={u(p.href)} aria-current={p.active ? 'page' : undefined}>{p.label}</a>)}
    </nav>
</div>
