---
import { u } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
import { CATEGORIES } from '../lib/feeds';
const path = Astro.url.pathname.replace(/\/?$/, '/');
const sections = [
    { href: u('/'), label: 'Today', cat: '' },
    ...CATEGORIES.map(c => ({ href: u(`/${c.slug}/`), label: c.short, cat: c.id })),
    { href: u('/canon/'), label: 'Canon', cat: '' },
    { href: u('/sources/'), label: 'Sources', cat: '' },
];
---
<div class="nav-wrap">
    <nav class="nav" aria-label="Primary">
        <a class="brand" href={u('/')}>
            <span class="brand-mark" aria-hidden="true">R</span>
            <span class="brand-name">The Reading Room</span>
        </a>
        <div class="nav-links">
            <a href={u('/week/')} aria-current={path.startsWith(u('/week/')) ? 'page' : undefined}>The week</a>
            <a href={u('/briefing/')} aria-current={path.startsWith(u('/briefing/')) ? 'page' : undefined}>Briefing</a>
            <a href={u('/business/')} aria-current={path.startsWith(u('/business/')) ? 'page' : undefined}>Business</a>
            <a href={u('/communities/')} aria-current={path.startsWith(u('/communities/')) ? 'page' : undefined}>Communities</a>
            <a href={u('/markets/')} aria-current={path.startsWith(u('/markets/')) ? 'page' : undefined}>Markets</a>
            <a href={u('/outages/')} aria-current={path.startsWith(u('/outages/')) ? 'page' : undefined}>Incidents</a>
            <a href={u('/puzzles/')} aria-current={path.startsWith(u('/puzzles/')) ? 'page' : undefined}>Puzzles</a>
            <a href={u('/roadmap/')} aria-current={path.startsWith(u('/roadmap/')) ? 'page' : undefined}>Roadmap</a>
        </div>
        <div class="nav-tools">
            <a href={u('/search/')} class="icon-btn" aria-label="Search" title="Search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </a>
            <ThemeToggle />
        </div>
    </nav>
    <nav class="sections-bar" aria-label="Sections">
        {/* On phones the top-bar pages live here, right after Today (so they aren't buried behind 13 desks);
            on wider screens they're hidden here because the top bar shows them. */}
        {sections.slice(0, 1).map(s => <a href={s.href} aria-current={path === u('/').replace(/\/?$/, '/') ? 'page' : undefined}>{s.label}</a>)}
        {[['/week/', 'The week'], ['/briefing/', 'Briefing'], ['/business/', 'Business'], ['/communities/', 'Communities'], ['/markets/', 'Markets'], ['/outages/', 'Incidents'], ['/puzzles/', 'Puzzles'], ['/roadmap/', 'Roadmap']].map(([href, label]) => (
            <a class="m-only" href={u(href)} aria-current={path.startsWith(u(href)) ? 'page' : undefined}>{label}</a>
        ))}
        <span class="m-only m-sep" aria-hidden="true"></span>
        {sections.slice(1).map(s => <a href={s.href} aria-current={path.startsWith(s.href) ? 'page' : undefined}>{s.cat && <span class="cat-dot" data-cat={s.cat}></span>}{s.label}</a>)}
    </nav>
</div>
