---
import { u } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
import { CATEGORIES } from '../lib/feeds';
const path = Astro.url.pathname.replace(/\/?$/, '/');
const sections = [
    { href: u('/'), label: 'Today', cat: '' },
    ...CATEGORIES.map(c => ({ href: u(`/${c.slug}/`), label: c.short, cat: c.id })),
    { href: u('/roadmap/'), label: 'Roadmap', cat: '' },
    { href: u('/canon/'), label: 'Canon', cat: '' },
    { href: u('/sources/'), label: 'Sources', cat: '' },
];
const notebookPaths = ['/notebook/'].map(p => u(p));
const isNotebook = notebookPaths.some(p => path.startsWith(p));
const isSaved = path.startsWith(u('/library/'));
---
<div class="nav-wrap">
    <nav class="nav" aria-label="Primary">
        <a class="brand" href={u('/')}>
            <span class="brand-mark" aria-hidden="true">R</span>
            <span class="brand-name">The Reading Room</span>
        </a>
        <div class="nav-links">
            <a href={u('/startups/')} aria-current={path.startsWith(u('/startups/')) ? 'page' : undefined}>Startups</a>
            <a href={u('/pulse/')} aria-current={path.startsWith(u('/pulse/')) ? 'page' : undefined}>Pulse</a>
            <a href={u('/briefing/')} aria-current={path.startsWith(u('/briefing/')) ? 'page' : undefined}>Briefing</a>
            <a href={u('/outages/')} aria-current={path.startsWith(u('/outages/')) ? 'page' : undefined}>Outages</a>
            <a href={u('/puzzles/')} aria-current={path.startsWith(u('/puzzles/')) ? 'page' : undefined}>Puzzles</a>
            <a href={u('/notebook/')} aria-current={isNotebook ? 'page' : undefined}>Notebook</a>
            <a href={u('/library/')} aria-current={isSaved ? 'page' : undefined}>Saved</a>
        </div>
        <div class="nav-tools">
            <a href={u('/search/')} class="icon-btn" aria-label="Search" title="Search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </a>
            <button type="button" class="icon-btn ai-toggle" data-ai-toggle aria-pressed="true" title="AI features are on: show content written by Claude (each piece is marked AI). Click to hide.">AI</button>
            <ThemeToggle />
        </div>
    </nav>
    <nav class="sections-bar" aria-label="Sections">
        {sections.map(s => {
            const active = s.href === u('/') ? path === u('/').replace(/\/?$/, '/') : path.startsWith(s.href);
            return <a href={s.href} aria-current={active ? 'page' : undefined}>{s.cat && <span class="cat-dot" data-cat={s.cat}></span>}{s.label}</a>;
        })}
        {/* On phones the top-bar links live here, so the header is two rows instead of three. */}
        <span class="m-only m-sep" aria-hidden="true"></span>
        <a class="m-only" href={u('/notebook/')} aria-current={isNotebook ? 'page' : undefined}>Notebook</a>
        <a class="m-only" href={u('/library/')} aria-current={isSaved ? 'page' : undefined}>Saved</a>
        <a class="m-only" href={u('/startups/')} aria-current={path.startsWith(u('/startups/')) ? 'page' : undefined}>Startups</a>
        <a class="m-only" href={u('/pulse/')} aria-current={path.startsWith(u('/pulse/')) ? 'page' : undefined}>Pulse</a>
        <a class="m-only" href={u('/briefing/')} aria-current={path.startsWith(u('/briefing/')) ? 'page' : undefined}>Briefing</a>
        <a class="m-only" href={u('/outages/')} aria-current={path.startsWith(u('/outages/')) ? 'page' : undefined}>Outages</a>
        <a class="m-only" href={u('/puzzles/')} aria-current={path.startsWith(u('/puzzles/')) ? 'page' : undefined}>Puzzles</a>
    </nav>
</div>
