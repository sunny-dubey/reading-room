---
import type { Item } from '../lib/content';
import { fmtDate } from '../lib/content';
import Tags from './Tags.astro';
interface Props { items: Item[]; showKind?: boolean; }
const { items, showKind = true } = Astro.props;
---
<ul class="items" role="list">
    {items.map(i => (
        <li class="item">
            <div class="item-meta">
                <time datetime={i.date.toISOString()}>{fmtDate(i.date)}</time>
                {showKind && <span class={`kind kind-${i.kind}`}>{i.kind}</span>}
            </div>
            <div class="item-body">
                <a class="item-title" href={i.href} {...(i.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    {i.title}{i.external && <span class="ext" aria-hidden="true"> ↗</span>}
                </a>
                {i.blurb && <p class="item-blurb">{i.blurb}</p>}
                <Tags tags={i.tags} />
            </div>
        </li>
    ))}
</ul>
