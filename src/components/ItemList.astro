---
import type { Item } from '../lib/content';
import { fmtDate } from '../lib/content';
import Tags from './Tags.astro';
interface Props { items: Item[]; showKind?: boolean; }
const { items, showKind = true } = Astro.props;
---
<ul class="rows" role="list">
    {items.map(i => (
        <li class={`tile hoverable k-${i.kind}`}>
            <div class="row">
                {showKind && <span class="kind">{i.kind}</span>}
                <a class="row-title stretched" href={i.href} {...(i.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    {i.title}{i.external && ' ↗'}
                </a>
                <time class="row-date" datetime={i.date.toISOString()}>{fmtDate(i.date)}</time>
            </div>
            {i.blurb && <p class="row-blurb">{i.blurb}</p>}
            <Tags tags={i.tags} />
        </li>
    ))}
</ul>
