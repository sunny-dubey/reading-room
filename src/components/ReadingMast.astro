---
import { editionName, istTime, istDate } from '../lib/edition';
interface Props {
    title: string; kicker?: string; sub?: string; updated?: Date; compact?: boolean; cat?: string;
    edition?: { at: Date; newReads: number };   // Today's masthead: "Late edition, 11:52 pm IST"
}
const { title, kicker, sub, updated, compact = false, cat, edition } = Astro.props;
---
<header class:list={['rd-mast', { compact }]}>
    {edition ? (
        <p class="rd-date rd-edition">
            <span data-edition-date={edition.at.toISOString()}>{istDate(edition.at)}</span>
            <span class="ed-sep" aria-hidden="true">·</span>
            <span class="ed-name">{editionName(edition.at)} edition,</span>
            <time data-edition-time datetime={edition.at.toISOString()} title={`${edition.at.toISOString().replace('T', ' ').slice(0, 16)} UTC`}>{istTime(edition.at)}</time>
        </p>
    ) : kicker && <p class="rd-date" data-today>{kicker}</p>}
    <h1 class="rd-title">{cat && <span class="cat-dot big" data-cat={cat}></span>}{title}</h1>
    {(sub || updated) && (
        <p class="rd-sub">{sub}{updated && <> · updated <time data-rel datetime={updated.toISOString()}></time></>}</p>
    )}
    {edition && (
        <p class="rd-next">
            <span data-next-edition>Next edition every 3 hours</span>
            <span class="ed-sep" aria-hidden="true">·</span>
            <span>{edition.newReads === 0 ? 'No new reads since the last edition' : `${edition.newReads} new ${edition.newReads === 1 ? 'read' : 'reads'} since the last edition`}</span>
        </p>
    )}
    <slot />
</header>
