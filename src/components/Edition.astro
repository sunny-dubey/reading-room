                        {pz.drill && <IncidentDrill i={pz.drill} />}
                        <a class="fp-more" href={u('/puzzles/')}>All {pz.puzzles.length} puzzles and the full numbers deck →</a>
                    </div>
                </div>
            </section>
        )}


        <!-- ===== Research ===== -->
</>)}
{part === 'research' && (<>
        <section class="fp-band reveal res-band" aria-label="Papers, explained">
            <h2 class="fp-band-h"><span>Papers, explained</span></h2>
            {research.length === 0 && <p class="fp-empty">No new papers in the last 24 hours.</p>}
            <ol class="band-list" role="list">
                {research.map(i => (
                    <li data-link={i.link} data-ts={+i.date} data-cat={i.category}>
                        <p class="band-meta"><span class="cat-dot" data-cat={i.category}></span>{categoryShort(i.category)} · {i.feedTitle} · <time data-rel datetime={i.date.toISOString()}></time></p>
