---
// One part of the edition (discover, learn, news, try, research, thoughts): the full bands for that part.
// The front page shows a short summary of each part; /discover/, /learn/, /news/, /try/, /papers/ and /thoughts/ render this.
import { u } from '../lib/url';
import Story from './Story.astro';
import Cover from './Cover.astro';
import Thumb from './Thumb.astro';
import Gets from './Gets.astro';
import { categoryShort, CATEGORIES } from '../lib/feeds';
import { EDITION_WINDOW } from '../lib/edition';
import ReadingClient from './ReadingClient.astro';
import { getReading, getCanon, rank, isDeep } from '../lib/reading';
import { getToday } from '../lib/today';
import { getOutages, fmtDuration, KINDS } from '../lib/outages';
import { getBriefing } from '../lib/briefing';
import MarketBrief from './MarketBrief.astro';
import PuzzleCard from './PuzzleCard.astro';
import NumbersCard from './NumbersCard.astro';
import IncidentDrill from './IncidentDrill.astro';
import PuzzleClient from './PuzzleClient.astro';
import { getPuzzles } from '../lib/puzzles';
import { getWebPuzzles, todaysPicks } from '../lib/web-puzzles';
import WebPuzzleList from './WebPuzzleList.astro';
import { getGitHub, LABEL } from '../lib/github';
import { KIND } from '../lib/summarize';
import { getBusiness, outlet } from '../lib/business';
import { getCommunities, communityName } from '../lib/communities';
import { getStartups } from '../lib/startups';

interface Props { part: 'discover' | 'learn' | 'news' | 'try' | 'research' | 'thoughts' }
const { part } = Astro.props;
const { big, learning, fetchedAt, now, deepRead, deepCands, fresh, picks, desks, wire, topStories, postmortem, tracks, pulse, startups, roadmap, bigtech, experimental, research, thoughts } = await getReading();
const su = await getStartups();
const canon = await getCanon();
const { question, explainer } = await getToday();
const pz = await getPuzzles();
const bf = await getBriefing();
const webPicks = todaysPicks(await getWebPuzzles(), now);
const bfDay = (t: number) => new Date(t).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
// Incident lessons: case studies picked in outages.ts.
const outages = await getOutages();
// The front page carries only the last 24 hours: incidents with an update in the edition window,
// lessons (a stated cause or a postmortem) first.
const lastUpdate = (i: { start: number; updates: { at: number }[] }) => Math.max(i.start, ...i.updates.map(x => x.at));
const recentIncidents = outages.incidents.filter(i => now - lastUpdate(i) < EDITION_WINDOW);
const recentLessons = [...recentIncidents].sort((a, b) => Number(!!(b.cause || b.rca)) - Number(!!(a.cause || a.rca)) || lastUpdate(b) - lastUpdate(a)).slice(0, 3);
const gh = await getGitHub(now, roadmap);
const biz = await getBusiness();
const cm = await getCommunities(now, roadmap);
const bizFront = [...biz.top, ...biz.river].slice(0, 6);
const ghStars = (n: number) => n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n);
const outAnchor = (id: string) => `inc-${id.replace(/[^a-z0-9]+/gi, '-')}`;
const mins = (m?: number) => (m ? `${m} min` : '');
const today = fetchedAt.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
const hours = (m: number) => m >= 90 ? `${Math.round(m / 60)} h` : `${m} min`;

// ---------- This week's design practice (rotates every Monday, IST) ----------
const IST = 5.5 * 3600e3;
const week = Math.floor((now + IST + 3 * 864e5) / (7 * 864e5)); // weeks since epoch, Monday-based
const practice = roadmap.practice.length ? roadmap.practice[week % roadmap.practice.length] : undefined;
// Plus the best recent article that teaches one of the exercise's topics.
const practiceFresh = practice?.topics.flatMap(t => roadmap.itemsByTopic.get(t.id) ?? [])
    .filter(i => isDeep(i) && (i.skill?.sim ?? 0) >= 0.5)
    .sort((a, b) => rank(b, now) - rank(a, now))[0];
---
<div class="fp edition-part">
{part === 'discover' && (<>
        <!-- ===== The big story: one thing covered by several independent sources ===== -->
        {big.length > 0 && (
            <section class="big-strip" aria-label="The big story">
                {big.map(b => (
                    <div class="big-story" data-link={b.lead.link}>
                        <p class="big-k">The big story · {b.sources} sources</p>
                        <a class="big-h" href={b.lead.link} target="_blank" rel="noopener noreferrer" data-read>{b.lead.title}</a>
                        <p class="big-cov">{b.items.map((i, n) => <>{n > 0 && ' · '}<a href={i.link} target="_blank" rel="noopener noreferrer">{i.feedTitle.replace(/: .*$/, '')}</a></>)}</p>
                    </div>
                ))}
            </section>
        )}

        <!-- ===== Startups worth approaching: engineering careers ===== -->
        {su.targets.length > 0 && (
            <section class="fp-band reveal su-targets" aria-label="Startups worth approaching">
                <h2 class="fp-band-h"><span>Startups worth approaching</span></h2>
                <ol class="su-target-list" role="list">
                    {su.targets.slice(0, 6).map(t => (
                        <li class={`su-t su-t-${t.kind}`}>
                            <p class="su-t-k">{t.kind === 'funding' ? 'Just raised' : t.kind === 'hiring' ? 'Hiring now' : 'YC launch'} · {t.signal}{t.topic ? ` · ${t.topic}` : ''}</p>
                            <a class="su-t-h" href={t.url} target="_blank" rel="noopener noreferrer" data-read>{t.name}</a>
                            <p class="su-t-line">{t.headline}</p>
                            <p class="su-t-how"><b>How to approach:</b> {t.approach.mention}</p>
                            <details class="su-t-more"><summary>Why it fits</summary><p class="su-t-why">{t.approach.why}</p></details>
                        </li>
                    ))}
                </ol>
                <a class="fp-more" href={u('/startups/#approach')}>All startups worth approaching, funding and hiring →</a>
            </section>
        )}

        <!-- ===== Big tech engineering: what large companies' engineering teams published, last 24 hours ===== -->
        <section class="fp-band reveal bt-front" aria-label="Big tech engineering">
            <h2 class="fp-band-h"><span>Big tech engineering · last 24 hours</span></h2>
            {bigtech.day.length === 0 && <p class="fp-empty">No new posts from big tech engineering teams in the last 24 hours. <a href={u('/big-tech/')}>See the week →</a></p>}
            <ol class="bt-grid" role="list">
                {bigtech.day.slice(0, 6).map(i => (
                    <li data-link={i.link} data-ts={+i.date} data-cat={i.category}>
                        <p class="bt-co">{i.feedTitle.replace(/\s*(Engineering|Tech Blog|Tech|Technology|Global Tech|Code as Craft|Blog)$/i, '')}</p>
                        <a class="bt-h" href={i.link} target="_blank" rel="noopener noreferrer" data-read>{i.title}</a>
                        <Gets i={i} compact />
                    </li>
                ))}
            </ol>
            {bigtech.day.length > 0 && <a class="fp-more" href={u('/big-tech/')}>All big tech engineering posts this week →</a>}
        </section>

        <!-- ===== On GitHub: the best technical project being built in the open, picked per edition ===== -->
        {gh.featured && (
            <section class="fp-band reveal gh-front" aria-label="On GitHub">
                <h2 class="fp-band-h"><span>On GitHub</span></h2>
                <div class="gh-grid">
                    <article class="gh-feat" data-cat={gh.featured.topic?.track}>
                        <p class="gh-k">Project of the edition</p>
                        <h3 class="gh-name"><a href={gh.featured.url} target="_blank" rel="noopener noreferrer" data-read>{gh.featured.name}</a></h3>
                        <p class="gh-desc">{gh.featured.description}</p>
                        <p class="gh-meta">{gh.featured.language && <span class="gh-lang">{gh.featured.language}</span>}<span>★ {ghStars(gh.featured.stars)}</span><span>+{ghStars(gh.featured.starsPerDay)} a day</span>{gh.featured.hn && <a href={gh.featured.hn.url} target="_blank" rel="noopener noreferrer">HN · {gh.featured.hn.points} points</a>}</p>
                        {gh.featured.topic && gh.featured.topic.sim >= LABEL && <p class="gh-why"><span class="cat-dot" data-cat={gh.featured.topic.track}></span>Why look: you'll get better at <a href={u(`/roadmap/#${gh.featured.topic.id}`)}>{gh.featured.topic.name}</a></p>}
                    </article>
                    <ol class="gh-list" role="list">
                        {gh.more.map(r => (
                            <li data-cat={r.topic?.track}>
                                <a class="gh-name" href={r.url} target="_blank" rel="noopener noreferrer" data-read>{r.name}</a>
                                <p class="gh-desc">{r.description}</p>
                                <p class="gh-meta">{r.language && <span class="gh-lang">{r.language}</span>}<span>★ {ghStars(r.stars)}</span>{r.hn && <a href={r.hn.url} target="_blank" rel="noopener noreferrer">HN {r.hn.points}</a>}{r.topic && r.topic.sim >= LABEL && <span class="gh-topic"><span class="cat-dot" data-cat={r.topic.track}></span>{r.topic.name}</span>}</p>
                            </li>
                        ))}
                    </ol>
                </div>
                <p class="gh-note">New and active open-source projects that Hacker News readers upvoted or that are gaining stars fast, kept only when they teach a Roadmap topic. Games, emulators, lists and courses are left out.</p>
            </section>
        )}

        <!-- ===== Communities: what tech communities are discussing, last 24 hours ===== -->
        {cm.total > 0 && (
            <section class="fp-band reveal cm-front" aria-label="Communities">
                <h2 class="fp-band-h"><span>Communities · last 24 hours</span></h2>
                <ul class="cm-front-list" role="list">
                    {cm.everywhere.slice(0, 1).map(g => (
                        <li>
                            <p class="cm-front-k">In {new Set(g.threads.map(t => t.community)).size} communities</p>
                            <a class="cm-t" href={g.threads[0].ext ?? g.threads[0].url} target="_blank" rel="noopener noreferrer">{g.threads[0].title}</a>
                            <p class="cm-meta">{[...new Set(g.threads.map(t => communityName(t.community)))].join(' · ')}</p>
                        </li>
                    ))}
                    {cm.gists.filter(g => g.threads.length).map(g => (
                        <li>
                            <p class="cm-front-k">{g.community.name}{g.themes[0] ? ` · mostly ${g.themes[0].area}` : ''}</p>
                            <a class="cm-t" href={g.threads[0].url} target="_blank" rel="noopener noreferrer">{g.threads[0].title}</a>
                            <p class="cm-meta">{g.threads[0].comments.toLocaleString('en-US')} {g.community.id === 'se' ? 'answers' : 'comments'}{g.threads[0].where ? ` · ${g.threads[0].where}` : ''}</p>
                        </li>
                    ))}
                </ul>
                <a class="fp-more" href={u('/communities/')}>What every community is talking about →</a>
            </section>
        )}


        <!-- ===== Read & learn ===== -->
</>)}
{part === 'learn' && (<>
        <nav class="desk-index" aria-label="Desks">
            <span class="desk-index-k">Desks</span>
            {CATEGORIES.map(c => <a href={u(`/${c.slug}/`)}><span class="cat-dot" data-cat={c.id}></span>{c.short}</a>)}
            <span class="desk-index-k">Study</span>
            <a href={u('/roadmap/')}>Roadmap</a><a href={u('/canon/')}>Canon</a><a href={u('/puzzles/')}>Puzzles</a><a href={u('/week/')}>The week</a>
        </nav>
        <!-- ===== Front: the lead story and the wire ===== -->
        <section class="fp-front">
            {deepRead && (
                <div class="fp-lead-wrap">
                    {deepCands.map((d, n) => (
                        <article class="fp-lead" data-deep-lead={d.link} data-link={d.link} data-cat={d.category} hidden={n > 0}>
                            <p class="fp-kicker">The deep read · {categoryShort(d.category)} · {mins(d.brief?.minutes)}</p>
                            <h2 class:list={["fp-lead-h", { long: d.title.length > 60 }]}><a href={d.link} target="_blank" rel="noopener noreferrer" data-read>{d.title}</a></h2>
                            {d.meta?.description && <p class="fp-dek" title="The author's own description">{d.meta.description}</p>}
                            <Gets i={d} />
                            {d.check && <p class="fp-check"><b>Check yourself:</b> {d.check}</p>}
                            <p class="fp-byline">By {d.feedTitle}</p>
                            <a href={d.link} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><Thumb i={d} w={760} h={280} class="fp-lead-art" eager={n === 0} /></a>
                            {d.classic && <p class="fp-footnote"><span>Builds on a classic</span><a href={d.classic.url} target="_blank" rel="noopener noreferrer">{d.classic.title}</a>, {d.classic.author}</p>}
                        </article>
                    ))}
                    {topStories.length > 0 && (
                        <div class="top-stories">
                            <h3 class="fp-box-h">Top stories</h3>
                            <div class="top-grid">{topStories.map((i, n) => <Story i={i} cover={n === 0 || !!i.meta?.thumb} deck={false} />)}</div>
                        </div>
                    )}
                </div>
            )}

            <aside class="fp-side">

                {question && (
                    <section class="fp-box qotd">
                        <h3 class="fp-box-h">Question of the day</h3>
                        <p class="qotd-q">{question.q}</p>
                        {question.hint && <details class="qotd-hint"><summary>Need a hint?</summary><p>{question.hint}</p></details>}
                        {(question.canon || question.read || question.topic) && (
                            <p class="qotd-reads"><span>Find the answer in</span>
                                {question.canon && <a href={question.canon.data.url} target="_blank" rel="noopener noreferrer">{question.canon.data.title}</a>}
                                {question.read && <a href={question.read.link} target="_blank" rel="noopener noreferrer">{question.read.title}</a>}
                                {question.topic && <a href={u(`/roadmap/#${question.topic.id}`)}>{question.topic.name} on the Roadmap</a>}
                            </p>
                        )}
                    </section>
                )}

            </aside>
        </section>

        <!-- ===== Latest from every desk ===== -->
        <section class="fp-band reveal">
            <h2 class="fp-band-h"><span>Latest from every desk</span></h2>
            <details class="desk-pick">
                <summary>Choose desks <span data-desk-count></span></summary>
                <div class="desk-pick-row" role="group" aria-label="Desks to show">
                    {desks.map(d => (
                        <button type="button" class="desk-chip" data-desk-toggle={d.id} aria-pressed="true"><span class="cat-dot" data-cat={d.id}></span>{d.short}</button>
                    ))}
                    <button type="button" class="desk-chip all" data-desk-all>Show all</button>
                </div>
                <p class="desk-pick-note">Hidden desks also leave the wire and top stories. Saved in this browser only.</p>
            </details>
            <p class="wk-link"><a href={u('/week/')}>Missed a few days? The week in every desk →</a></p>
            <div class="desks">
                {desks.map(d => (
                    <section class="desk" data-cat={d.id}>
                        <h3 class="desk-h"><a href={u(`/${d.slug}/`)}><span class="cat-dot" data-cat={d.id}></span>{d.short}</a></h3>
                        {d.items.map((i, n) => (
                            <article class:list={['desk-item', { first: n === 0 }]} data-link={i.link} data-ts={+i.date} data-story>
                                {n === 0 && <a href={i.link} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><Thumb i={i} w={360} h={110} /></a>}
                                <p class="desk-meta"><span class="new-badge" data-new hidden>New</span><time data-rel datetime={i.date.toISOString()}></time></p>
                                <a class="desk-title" href={i.link} target="_blank" rel="noopener noreferrer" data-read>{i.title}</a>
                                {n === 0 && i.meta?.description && <p class="desk-dek">{i.meta.description}</p>}
                                {n === 0 && <Gets i={i} compact />}
                                <span class="desk-src">{i.feedTitle}</span>
                            </article>
                        ))}
                    </section>
                ))}
            </div>
        </section>

        <!-- ===== Bottom row ===== -->
        <section class="fp-band fp-bottom reveal">
            {postmortem && (
                <div class="fp-cell" data-link={postmortem.link} data-cat="postmortems">
                    <h3 class="fp-box-h">Learn from failure</h3>
                    <a href={postmortem.link} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><Cover seed={postmortem.title} track="postmortems" w={320} h={120} /></a>
                    <a class="fp-cell-h" href={postmortem.link} target="_blank" rel="noopener noreferrer" data-read>{postmortem.title}</a>
                    <p class="story-by">{postmortem.feedTitle}{postmortem.brief?.minutes ? ` · ${postmortem.brief.minutes} min` : ''}</p>
                    <a class="fp-more" href={u('/postmortems/')}>More postmortems →</a>
                </div>
            )}
            {explainer && (
                <div class="fp-cell" data-cat={explainer.track} data-link={explainer.url}>
                    <h3 class="fp-box-h">See it, don't just read it</h3>
                    <a href={explainer.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><Cover seed={explainer.title} track={explainer.track} w={320} h={120} /></a>
                    <a class="fp-cell-h" href={explainer.url} target="_blank" rel="noopener noreferrer" data-read>{explainer.title}</a>
                    <p class="fp-cell-p">{explainer.why}</p>
                    <p class="story-by">{explainer.author} · {explainer.minutes} min · interactive</p>
                </div>
            )}
        </section>

        <!-- ===== Informative ===== -->
</>)}
{part === 'news' && (<>
        <MarketBrief />
        <div class="news-cols">
                <section class="fp-box wire" aria-label="The wire">
                    <h3 class="fp-box-h">The wire <span class="web-note">newest first, every desk</span></h3>
                    <ol class="wire-list" role="list">
                        {wire.map(i => (
                            <li data-link={i.link} data-cat={i.category} data-ts={+i.date}>
                                <span class="wire-meta"><span class="new-badge" data-new hidden>New</span><span class="cat-dot" data-cat={i.category} title={categoryShort(i.category)}></span><time data-rel datetime={i.date.toISOString()}></time></span>
                                <a href={i.link} target="_blank" rel="noopener noreferrer" data-read>{i.title}</a>
                                <span class="wire-src">{i.feedTitle}{i.brief?.minutes ? ` · ${i.brief.minutes} min` : ''}</span>
                            </li>
                        ))}
                    </ol>
                </section>
                <section class="fp-box biz-box" aria-label="Business and economy">
                    <h3 class="fp-box-h"><a href={u('/business/')}>Business &amp; economy</a> <span class="web-note">last 24 hours</span></h3>
                    {bizFront.length === 0 && <p class="fp-empty">No business news in the last 24 hours yet.</p>}
                    <ol role="list">
                        {bizFront.map(s => (
                            <li data-link={s.lead.link} data-ts={+s.lead.date}>
                                <a class="biz-t" href={s.lead.link} target="_blank" rel="noopener noreferrer" data-read>{s.lead.title}</a>
                                <p class="biz-meta"><time data-rel datetime={s.lead.date.toISOString()}></time> · {outlet(s.lead)}{s.outlets > 1 ? ` + ${s.outlets - 1} more` : ''}</p>
                            </li>
                        ))}
                    </ol>
                    <a class="fp-more" href={u('/business/')}>All business &amp; economy news →</a>
                </section>
        </div>
        <!-- ===== The briefing ===== -->
        <section class="fp-band reveal bf-front">
            <h2 class="fp-band-h"><span>The briefing</span></h2>
            <div class="bf-boxes">
                <div class="bf-box">
                    <h3 class="fp-box-h"><a href={u('/briefing/#releases')}>Release radar</a></h3>
                    {bf.releases.length === 0 && <p class="fp-empty">No new releases in your stack in the last 24 hours.</p>}
                    <ul role="list">{bf.releases.slice(0, 6).map(r => <li><b>{r.product}</b> <span class="mono">{r.version}</span>{r.newCycle && <span class="bf-tag new">new</span>}<span class="bf-date">{bfDay(r.date)}</span></li>)}</ul>
                </div>
                <div class="bf-box">
                    <h3 class="fp-box-h"><a href={u('/briefing/#eol')}>Obituaries</a></h3>
                    <ul role="list">{bf.eols.filter(e => e.days >= -14).slice(0, 6).map(e => <li class:list={{ dead: e.days < 0 }}><b>{e.product} {e.cycle}</b><span class="bf-date">{e.days < 0 ? `died ${-e.days}d ago` : e.days === 0 ? 'dies today' : `dies in ${e.days}d`}</span></li>)}</ul>
                </div>
                <div class="bf-box">
                    <h3 class="fp-box-h"><a href={u('/briefing/#cves')}>CVE watch · exploited now</a></h3>
                    {bf.cves.length === 0 && <p class="fp-empty">CISA added no exploited vulnerabilities in the last 24 hours.</p>}
                    <ul role="list">{bf.cves.slice(0, 5).map(c => <li class:list={{ mine: c.mine }}><b>{c.vendor} {c.product}</b>{c.ransomware && <span class="bf-tag ransom">ransomware</span>}<span class="bf-date">{bfDay(c.added)}</span></li>)}</ul>
                </div>
                <div class="bf-box">
                    <h3 class="fp-box-h"><a href={u('/briefing/#papers')}>Paper drop</a></h3>
                    {bf.papers.length === 0 && <p class="fp-empty">No new arXiv papers in the last 24 hours (arXiv doesn’t post at weekends).</p>}
                    <ul role="list">{bf.papers.slice(0, 4).map(p => <li><a href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a><span class="bf-date">{p.code ? <a href={`https://github.com/${p.code.repo}`} target="_blank" rel="noopener noreferrer">code ★{p.code.stars}</a> : p.topic?.name}</span></li>)}</ul>
                </div>
                <div class="bf-box">
                    <h3 class="fp-box-h"><a href={u('/briefing/#standards')}>Standards radar</a></h3>
                    {bf.standards.length === 0 && <p class="fp-empty">No new RFCs, kernels or runtime releases in the last 24 hours.</p>}
                    <ul role="list">{bf.standards.slice(0, 5).map(x => <li><a href={x.url} target="_blank" rel="noopener noreferrer">{x.title}</a><span class="bf-date">{x.kind === 'Release' ? x.who : x.kind}</span></li>)}</ul>
                </div>
                <div class="bf-box">
                    <h3 class="fp-box-h"><a href={u('/briefing/#talks')}>Talk radar</a></h3>
                    {bf.talks.length === 0 && <p class="fp-empty">No new conference talks in the last 24 hours.</p>}
                    <ul role="list">{bf.talks.slice(0, 5).map(x => <li><a href={x.url} target="_blank" rel="noopener noreferrer">{x.title}</a><span class="bf-date">{x.who}</span></li>)}</ul>
                </div>
            </div>
        </section>

        <!-- ===== Incident lessons: real outages with a stated cause or a postmortem ===== -->
        {(
            <section class="fp-band reveal out-front">
                <h2 class="fp-band-h"><span>Incidents · last 24 hours</span></h2>
                {recentLessons.length === 0 && <p class="fp-empty">No public incidents at the providers we follow in the last 24 hours.</p>}
                <ul class="out-lessons" role="list">
                    {recentLessons.map(i => (
                        <li>
                            <p class="fp-kicker">{i.provider} · {KINDS[i.kind]}{i.ongoing ? ' · ongoing' : i.duration ? ` · ${fmtDuration(i.duration)} to fix` : ''}{i.rca ? ' · postmortem' : ''}</p>
                            {outages.cases.includes(i)
                                ? <a class="out-lesson-t" href={u(`/outages/#${outAnchor(i.id)}`)}>{i.title}</a>
                                : <a class="out-lesson-t" href={i.url} target="_blank" rel="noopener noreferrer">{i.title}</a>}
                            {i.cause && <p class="out-lesson-cause">{i.cause}</p>}
                        </li>
                    ))}
                </ul>
                <a class="fp-more" href={u('/outages/')}>Case studies and the reliability table →</a>
            </section>
        )}


        <!-- ===== Try it ===== -->
</>)}
{part === 'try' && (<>
        <section class="fp-band reveal exp-band" aria-label="Things to try">
            <h2 class="fp-band-h"><span>Things to try</span></h2>
            {experimental.length === 0 && <p class="fp-empty">No hands-on pieces in the last 24 hours.</p>}
            <ol class="band-list" role="list">
                {experimental.map(i => (
                    <li data-link={i.link} data-ts={+i.date} data-cat={i.category}>
                        <p class="band-meta"><span class="cat-dot" data-cat={i.category}></span>{categoryShort(i.category)} · {i.feedTitle} · <time data-rel datetime={i.date.toISOString()}></time></p>
                        <a class="band-h" href={i.link} target="_blank" rel="noopener noreferrer" data-read>{i.title}</a>
                        <Gets i={i} />
                    </li>
                ))}
            </ol>
        </section>

        <!-- ===== The puzzle page ===== -->
        {pz.today && (
            <section class="fp-band reveal puzzle-band">
                <h2 class="fp-band-h"><span>The puzzle page</span></h2>
                <div class="puzzle-grid">
                    <div class="puzzle-main">
                        <PuzzleCard p={pz.today} featured />
                        {webPicks.length > 0 && (
                            <div class="web-today">
                                <h3 class="fp-box-h">From around the web <span class="web-note">links to the originals, credited</span></h3>
