---
// The outage map: dotted land, one marker per place an incident names. Ongoing incidents pulse; older ones fade.
import { getWorldDots, project, MAP_W, MAP_H } from '../lib/worldmap';
import { fmtDuration, type Incident } from '../lib/outages';
import { u } from '../lib/url';
interface Props { incidents: Incident[]; now: number; size?: 'small' | 'large' }
const { incidents, now, size = 'large' } = Astro.props;
const dots = await getWorldDots();
const anchor = (i: Incident) => `inc-${i.id.replace(/[^a-z0-9]+/gi, '-')}`;
const markers = incidents.flatMap(i => i.places.map(p => ({ i, p, ...project(p.lat, p.lon) })))
    // Older first, so the newest draw on top.
    .sort((a, b) => a.i.start - b.i.start);
const ageH = (i: Incident) => Math.round((now - i.start) / 3600e3);
const unlocated = incidents.filter(i => !i.places.length).length;
---
<div class={`omap omap-${size}`} data-omap>
    <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} role="img" aria-label={`World map of ${incidents.length} incidents`}>
        <path class="omap-land" d={dots} />
        {markers.map(m => (
            <a href={size === 'large' ? `#${anchor(m.i)}` : u(`/outages/#${anchor(m.i)}`)} class:list={['omap-mk', `sev-${m.i.severity}`, { ongoing: m.i.ongoing, approx: m.p.approx }]}
                data-kind={m.i.kind} data-age-h={ageH(m.i)} data-target={anchor(m.i)}
                data-tip-title={m.i.title} data-tip-meta={`${m.i.provider} · ${m.p.name}${m.p.approx ? ' (approx.)' : ''} · ${m.i.ongoing ? 'ongoing' : fmtDuration(m.i.duration) || 'resolved'}`}
                style={`--age:${Math.min(1, ageH(m.i) / 720)}`} transform={`translate(${m.x} ${m.y})`}>
                {m.i.ongoing && <circle class="omap-pulse" r="10" />}
                <circle class="omap-dot" r={m.i.severity === 'major' ? 7 : 5} />
            </a>
        ))}
    </svg>
    <div class="omap-tip" data-omap-tip hidden></div>
    {unlocated > 0 && <p class="omap-global"><span class="omap-ring"></span>{unlocated} global or unlocated {unlocated === 1 ? 'incident' : 'incidents'}, not pinned</p>}
</div>

<script>
    // Tooltips on hover/focus; one script serves every map on the page.
    document.querySelectorAll<HTMLElement>('[data-omap]').forEach(map => {
        const tip = map.querySelector<HTMLElement>('[data-omap-tip]')!;
        const show = (m: SVGElement) => {
            tip.innerHTML = '';
            const b = document.createElement('strong'); b.textContent = m.dataset.tipTitle ?? '';
            const s = document.createElement('span'); s.textContent = m.dataset.tipMeta ?? '';
            tip.append(b, s);
            const fr = map.getBoundingClientRect(), r = m.getBoundingClientRect();
            tip.style.left = `${Math.min(fr.width - 240, Math.max(0, r.left - fr.left + r.width / 2 - 120))}px`;
            tip.style.top = `${r.top - fr.top - 10}px`;
            tip.hidden = false;
        };
        map.querySelectorAll<SVGElement>('.omap-mk').forEach(m => {
            m.addEventListener('mouseenter', () => show(m));
            m.addEventListener('focus', () => show(m));
            m.addEventListener('mouseleave', () => (tip.hidden = true));
            m.addEventListener('blur', () => (tip.hidden = true));
        });
    });
</script>
