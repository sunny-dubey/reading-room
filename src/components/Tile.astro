---
interface Props {
    label?: string;
    k?: string;          // accent key: log | note | writing | library | reading | neutral
    href?: string;       // "view all" link in the header
    linkLabel?: string;
    class?: string;
    glow?: boolean;
}
const { label, k = 'neutral', href, linkLabel = 'View all →', class: cls = '', glow = false } = Astro.props;
---
<section class={`tile k-${k} ${glow ? 'tile-glow' : ''} ${cls}`}>
    {(label || href) && (
        <div class="tile-head">
            {label && <span class="tile-label">{label}</span>}
            <slot name="head" />
            {href && <a class="tile-link" href={href}>{linkLabel}</a>}
        </div>
    )}
    <div class="tile-body"><slot /></div>
</section>
