---
// Shared behaviour for every Reading Room page. Include once per page.
import { getCollection } from 'astro:content';
import { getProgress } from '../lib/progress';
const progress = await getProgress();
// Chapters of long Canon works, for "next chapter" everywhere.
const parts = Object.fromEntries((await getCollection('canon')).filter(c => c.data.parts?.length)
    .map(c => [c.id, { title: c.data.title, url: c.data.url, parts: c.data.parts }]));
---
<script type="application/json" id="repo-progress" set:html={JSON.stringify(progress)} />
<script type="application/json" id="canon-parts" set:html={JSON.stringify(parts)} />
<script>
    import { getSet, setProgress } from '../lib/progress-client';
    import { getHistory, recordRead } from '../lib/history-client';
    import { nextPart, markPart, partId, works } from '../lib/canon-parts-client';

    // ---------- relative times, in the reader's own timezone ----------
    const rtf = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
    document.querySelectorAll<HTMLTimeElement>('time[data-rel]').forEach(t => {
        const d = new Date(t.dateTime);
        const mins = Math.round((Date.now() - +d) / 60000);
        const days = Math.round(mins / 1440);
        t.textContent = mins < 1 ? 'just now'
            : mins < 60 ? rtf.format(-mins, 'minute')
            : mins < 1440 ? rtf.format(-Math.round(mins / 60), 'hour')
            : days < 30 ? rtf.format(-days, 'day')
            : d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: days > 300 ? 'numeric' : undefined });
        t.title = d.toLocaleString();
    });
    // ---------- "New" badge: posts published in the last 48 hours (from when you're reading) ----------
    document.querySelectorAll<HTMLElement>('[data-ts]').forEach(el => {
        const badge = el.querySelector<HTMLElement>('[data-new]');
        if (badge) badge.hidden = Date.now() - Number(el.dataset.ts) > 48 * 3600e3;
    });
    // ---------- editions: show build time in the reader's timezone ----------
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const tzName = (d: Date) => {
        const short = new Intl.DateTimeFormat(undefined, { timeZoneName: 'short' }).formatToParts(d).find(p => p.type === 'timeZoneName')?.value ?? '';
        if (/^GMT[+-]/.test(short) || short === 'UTC') {
            // Prefer a familiar abbreviation where the reader's locale doesn't have one (e.g. IST).
            const alt = new Intl.DateTimeFormat('en-IN', { timeZoneName: 'short', timeZone: tz }).formatToParts(d).find(p => p.type === 'timeZoneName')?.value;
            if (alt && !/^GMT[+-]/.test(alt)) return alt;
        }
        return short;
    };
    const clock = (d: Date) => d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' }).toLowerCase().replace(/\s?(am|pm)$/, ' $1');
    document.querySelectorAll<HTMLTimeElement>('[data-edition-time]').forEach(t => {
        const d = new Date(t.dateTime);
        t.textContent = `${clock(d)} ${tzName(d)}`;
    });
    document.querySelectorAll<HTMLElement>('[data-edition-date]').forEach(el => {
        el.textContent = new Date(el.dataset.editionDate!).toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    });
    document.querySelectorAll<HTMLElement>('[data-next-edition]').forEach(el => {
        // Next scheduled build: 00:17, 06:17, 12:17, 18:17 UTC. GitHub often runs a little late, hence "around".
        const now = new Date();
        const mins = now.getUTCHours() * 60 + now.getUTCMinutes();
        const slots = [17, 377, 737, 1097];
        const nextSlot = slots.find(s => s > mins) ?? slots[0] + 1440;
        const next = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()) + nextSlot * 60000);
        const sameDay = next.toDateString() === now.toDateString();
        el.textContent = `Next edition around ${clock(next)}${sameDay ? '' : ' tomorrow'}`;
        el.title = `Scheduled for ${next.toISOString().slice(11, 16)} UTC; GitHub sometimes runs 5–30 minutes late`;
    });

    document.querySelectorAll<HTMLElement>('[data-today]').forEach(el => {
        el.textContent = new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
    });

    // ---------- read tracking: dims what you've opened, remembers when (for revisits) ----------
    const paintRead = () => {
        const read = new Set(getHistory().map(r => r.u));
        document.querySelectorAll<HTMLElement>('[data-link]').forEach(el => el.classList.toggle('is-read', read.has(el.dataset.link!)));
    };
    paintRead();
    document.addEventListener('click', e => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-read]');
        const host = a?.closest<HTMLElement>('[data-link]');
        if (!a || !host) return;
        recordRead(host.dataset.link!, a.textContent?.trim() ?? '');
        paintRead();
    });

    // ---------- the Canon: progress per track ----------
    let done = getSet('canon');
    function paintCanon() {
        done = getSet('canon');
        // Chapters on the Canon page.
        document.querySelectorAll<HTMLInputElement>('[data-part-toggle]').forEach(cb => {
            cb.checked = done.has(cb.dataset.partToggle!);
            cb.closest('li')?.classList.toggle('is-done', cb.checked);
        });
        document.querySelectorAll<HTMLElement>('[data-parts-of]').forEach(el => {
            const id = el.dataset.partsOf!, w = works[id];
            if (!w) return;
            const n = w.parts.filter((_, j) => done.has(partId(id, j))).length;
            const next = nextPart(id, done);
            el.textContent = next ? `${n} of ${w.parts.length} done · next: ${next.part.title}` : `All ${w.parts.length} done`;
        });
        // Next-up cards: a long work shows its next chapter, and "done" finishes the chapter.
        document.querySelectorAll<HTMLElement>('[data-next-part]').forEach(el => {
            const id = el.dataset.nextPart!, next = nextPart(id, done);
            const btn = el.closest('.next-item')?.querySelector<HTMLButtonElement>('[data-mark-done]');
            if (!next) { el.hidden = true; return; }
            el.hidden = false;
            el.innerHTML = '';
            const label = document.createElement('span');
            label.textContent = `Next chapter (${next.i + 1} of ${next.n}): `;
            const a = document.createElement('a');
            a.href = next.url; a.target = '_blank'; a.rel = 'noopener noreferrer';
            a.textContent = next.part.title;
            el.append(label, a, document.createTextNode(` · ${next.part.minutes} min`));
            if (btn) { btn.dataset.partDone = partId(id, next.i); btn.textContent = 'Finished chapter ✓'; }
        });
        document.querySelectorAll<HTMLInputElement>('[data-canon-toggle]').forEach(cb => {
            cb.checked = done.has(cb.dataset.canonToggle!);
            cb.closest('.canon-item')?.classList.toggle('is-done', cb.checked);
        });
        document.querySelectorAll<HTMLElement>('[data-canon-track]').forEach(sec => {
            const ids = [...sec.querySelectorAll<HTMLElement>('[data-canon-id]')].map(x => x.dataset.canonId!);
            const n = ids.filter(id => done.has(id)).length;
            const count = sec.querySelector('[data-canon-count]');
            const bar = sec.querySelector<HTMLElement>('[data-canon-bar]');
            if (count) count.textContent = `${n} / ${ids.length}`;
            if (bar) bar.style.width = `${ids.length ? (n / ids.length) * 100 : 0}%`;
        });
        // "Next up": show the first unfinished canon item for each track.
        document.querySelectorAll<HTMLElement>('[data-next-track]').forEach(box => {
            const candidates = [...box.querySelectorAll<HTMLElement>('[data-next-id]')];
            const next = candidates.find(c => !done.has(c.dataset.nextId!));
            candidates.forEach(c => (c.hidden = c !== next));
            const finished = box.querySelector<HTMLElement>('[data-next-done]');
            if (finished) finished.hidden = !!next;
            const prog = box.querySelector('[data-next-progress]');
            if (prog) prog.textContent = `${candidates.filter(c => done.has(c.dataset.nextId!)).length} of ${candidates.length} done`;
        });
    }
    document.addEventListener('change', e => {
        const cb = (e.target as HTMLElement).closest<HTMLInputElement>('[data-canon-toggle]');
        if (!cb) return;
        cb.checked ? done.add(cb.dataset.canonToggle!) : done.delete(cb.dataset.canonToggle!);
        setProgress('canon', cb.dataset.canonToggle!, cb.checked);
        paintCanon();
    });
    document.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-mark-done]');
        if (!btn) return;
        if (btn.dataset.partDone) { markPart(btn.dataset.partDone, true); return; }
        done.add(btn.dataset.markDone!);
        setProgress('canon', btn.dataset.markDone!, true);
        paintCanon();
    });
    document.addEventListener('change', e => {
        const cb = (e.target as HTMLElement).closest<HTMLInputElement>('[data-part-toggle]');
        if (cb) markPart(cb.dataset.partToggle!, cb.checked);
    });
    document.addEventListener('canon:changed', paintCanon);
    paintCanon();

    // ---------- "show more" toggles ----------
    document.querySelectorAll<HTMLButtonElement>('[data-expand]').forEach(b => b.addEventListener('click', () => {
        document.getElementById(b.dataset.expand!)?.classList.remove('collapsed');
        b.remove();
    }));

</script>
