---
import Base from './Base.astro';
import Tags from '../components/Tags.astro';
import { u } from '../lib/url';
interface Props {
    title: string;
    description?: string;
    meta: string;
    tags: string[];
    back: { href: string; label: string };
    k: string;
    edit?: { kind: 'log' | 'note' | 'writing'; id: string };
}
const { title, description, meta, tags, back, k, edit } = Astro.props;
const dev = import.meta.env.DEV;
const editHref = edit ? u('/write/') + '?kind=' + edit.kind + '&id=' + edit.id : '';
---
<Base title={title} description={description} accent={k}>
    <article class="narrow">
        <header class="entry-head">
            <div class="entry-top">
                <a class="back" href={back.href}>← {back.label}</a>
                {dev && editHref && <a class="back edit-link" href={editHref}>Edit</a>}
            </div>
            <h1>{title}</h1>
            {description && <p class="entry-lead">{description}</p>}
            <div class="entry-meta"><span>{meta}</span><Tags tags={tags} /></div>
        </header>
        <div class="tile entry-body">
            <div class="prose"><slot /></div>
        </div>
        <slot name="after" />
    </article>
</Base>
