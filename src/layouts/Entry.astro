---
import Base from './Base.astro';
import Tags from '../components/Tags.astro';
import { u } from '../lib/url';
interface Props {
    title: string;
    meta: string;
    tags: string[];
    back: { href: string; label: string };
    k: string;
    edit?: string;      // note id (local-only Edit link)
    source?: string;    // the piece this note is about
    description?: string;
}
const { title, meta, tags, back, k, edit, source, description } = Astro.props;
const dev = import.meta.env.DEV;
const editHref = edit ? `${u('/write/')}?id=${edit}` : '';
const host = (url: string) => { try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return url; } };
---
<Base title={title} description={description} accent={k}>
    <article class="narrow">
        <header class="entry-head">
            <div class="entry-top">
                <a class="back" href={back.href}>← {back.label}</a>
                {dev && editHref && <a class="back edit-link" href={editHref}>Edit</a>}
            </div>
            <h1>{title}</h1>
            <div class="entry-meta">
                <span>{meta}</span>
                {source && <a class="entry-source" href={source} target="_blank" rel="noopener noreferrer">on {host(source)} ↗</a>}
                <Tags tags={tags} />
            </div>
        </header>
        <div class="tile entry-body">
            <div class="prose"><slot /></div>
        </div>
    </article>
</Base>
