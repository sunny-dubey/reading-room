---
// The front page: masthead, the time budget, a link to Today's summary, and six short boxes (≤3 items each)
// that open the part pages. The full bands live in src/components/Edition.astro.
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Gets from '../components/Gets.astro';
import ReadingClient from '../components/ReadingClient.astro';
import { categoryShort } from '../lib/feeds';
import { editionName, istTime, istDate, EDITION_WINDOW } from '../lib/edition';
import { getReading, rank, bandOf } from '../lib/reading';
import { getOutages } from '../lib/outages';
import { getBriefing } from '../lib/briefing';
import { getPuzzles } from '../lib/puzzles';
import { getGitHub } from '../lib/github';
import { KIND } from '../lib/summarize';
import { getBusiness, outlet } from '../lib/business';
import { getCommunities } from '../lib/communities';
import { getStartups } from '../lib/startups';

const { learning, fetchedAt, now, deepCands, wire, topStories, desks, roadmap, bigtech, experimental, research, thoughts } = await getReading();
const su = await getStartups();
const pz = await getPuzzles();
const bf = await getBriefing();
const outages = await getOutages();
// Incidents with an update in the edition window, lessons (a stated cause or a postmortem) first.
const lastUpdate = (i: { start: number; updates: { at: number }[] }) => Math.max(i.start, ...i.updates.map(x => x.at));
const recentLessons = outages.incidents.filter(i => now - lastUpdate(i) < EDITION_WINDOW)
    .sort((a, b) => Number(!!(b.cause || b.rca)) - Number(!!(a.cause || a.rca)) || lastUpdate(b) - lastUpdate(a)).slice(0, 3);
const gh = await getGitHub(now, roadmap);
const biz = await getBusiness();
const cm = await getCommunities(now, roadmap);
// Time budget: the edition's worthwhile pieces with a known reading time, best first (picked in the browser).
const budgetPool = learning.filter(i => +i.date <= now && now - +i.date < EDITION_WINDOW && (i.brief?.worth ?? 0) >= 3 && (i.brief?.minutes ?? 0) > 0 && !i.hype)
    .sort((a, b) => rank(b, now) - rank(a, now)).slice(0, 60)
    .map(i => ({ u: i.link, t: i.title, m: i.brief!.minutes, k: i.brief?.kind ? KIND[i.brief.kind].label : '', d: categoryShort(i.category) }));
const issue = Math.floor((+fetchedAt - Date.UTC(2026, 10, 17)) / 864e5) + 1; // No. 1 = the site's first day
const lead = deepCands[0];
const notLead = (i: { link: string }) => i.link !== lead?.link;
type Item = { href: string; title: string; meta: string };
const cards: { slug: string; title: string; href: string; sub: string; items: Item[]; empty: string }[] = [
    { slug: 'discover', title: 'Discover', href: '/discover/', sub: 'Startups worth approaching, big tech engineering, GitHub and communities', empty: 'Nothing new to discover in the last 24 hours.', items: [
        ...su.targets.slice(0, 1).map(t => ({ href: t.url, title: t.name, meta: t.kind === 'funding' ? t.signal : t.kind === 'hiring' ? `Hiring · ${t.signal.replace(/^Hiring on HN · /, '')}` : t.signal })),
        ...bigtech.day.filter(notLead).slice(0, 1).map(i => ({ href: i.link, title: i.title, meta: i.feedTitle })),
        ...(gh.featured ? [{ href: gh.featured.url, title: gh.featured.name, meta: `On GitHub${gh.featured.language ? ` · ${gh.featured.language}` : ''}` }] : []),
    ].slice(0, 3) },
    { slug: 'learn', title: 'Learn', href: '/learn/', sub: 'The clearest deep reads of the day, then every desk', empty: 'No deep reads in the last 24 hours.', items:
        // Top stories first; on a quiet day, the best piece from each desk fills the card.
        [...topStories, ...desks.flatMap(d => d.items).filter(i => ['learn', 'experimental'].includes(bandOf(i)))].filter(notLead).filter((i, k, a) => a.findIndex(x => x.link === i.link) === k).slice(0, 3).map(i => ({ href: i.link, title: i.title, meta: `${categoryShort(i.category)}${i.brief?.minutes ? ` · ${i.brief.minutes} min` : ''}` })) },
    { slug: 'news', title: 'News', href: '/news/', sub: 'Markets, business, releases, vulnerabilities and incidents', empty: 'No news in the last 24 hours.', items: [
        ...[...biz.top, ...biz.river].slice(0, 1).map(b => ({ href: b.lead.link, title: b.lead.title, meta: outlet(b.lead) })),
        ...wire.filter(i => !i.hype && notLead(i)).slice(0, 1).map(i => ({ href: i.link, title: i.title, meta: categoryShort(i.category) })),
        ...[...bf.standards.slice(0, 1).map(x => ({ href: x.url, title: x.title, meta: x.kind === 'Release' ? x.who : x.kind })), ...recentLessons.slice(0, 1).map(i => ({ href: i.url, title: i.title, meta: `Incident · ${i.provider}` }))].slice(0, 1),
    ] },
    { slug: 'try', title: 'Try it', href: '/try/', sub: 'Hands-on pieces to follow along with, and the daily puzzle', empty: 'Nothing hands-on in the last 24 hours.', items: [
        ...experimental.filter(notLead).slice(0, 2).map(i => ({ href: i.link, title: i.title, meta: `${i.brief?.kind ? KIND[i.brief.kind].label : 'How-to'}${i.brief?.minutes ? ` · ${i.brief.minutes} min` : ''}` })),
        ...(pz.today ? [{ href: u('/try/'), title: pz.today.title, meta: "Today's puzzle" }] : []),
    ] },
    { slug: 'research', title: 'Research', href: '/papers/', sub: 'New papers, explained in plain words first', empty: 'No new papers in the last 24 hours.', items:
        research.slice(0, 3).map(i => ({ href: i.link, title: i.title, meta: categoryShort(i.category) })) },
    { slug: 'thoughts', title: 'Thoughts', href: '/thoughts/', sub: 'Essays and opinion, for perspective', empty: 'No essays in the last 24 hours.', items:
        thoughts.slice(0, 4).map(i => ({ href: i.link, title: i.title, meta: i.feedTitle })) },
];
// Each headline appears once on the home page: an earlier card keeps it (cards are in priority order).
{
    const seen = new Set<string>(lead ? [lead.link] : []);
    for (const c of cards) c.items = c.items.filter(x => !seen.has(x.href) && !!seen.add(x.href)).slice(0, 3);
}
---
<Base description="Learn something real every day: distributed systems, architecture, AI engineering, ML, security and maths." accent="reading">
    <div class="home">
        <!-- ===== Header: title, one line, a quiet date line ===== -->
        <header class="home-mast">
            <h1 class="home-title">The Reading Room</h1>
            <p class="home-tag">A reading and discovery room for careers in software and the industries around it, edited by a local AI.</p>
            <p class="home-meta"><span data-edition-date={fetchedAt.toISOString()}>{istDate(fetchedAt)}</span> · {editionName(fetchedAt)} edition · <time data-edition-time datetime={fetchedAt.toISOString()}>{istTime(fetchedAt)}</time> · No. {issue}</p>
            <p class="fp-stale" data-stale={fetchedAt.toISOString()} hidden></p>
            <p class="fp-since" data-since hidden></p>
        </header>

        <!-- ===== Start here: the day's best piece, then the reading plan ===== -->
        {lead && (
            <section class="home-hero" data-link={lead.link} aria-label="Start here">
                <p class="home-k">Start here{lead.brief?.kind ? ` · ${KIND[lead.brief.kind].label}` : ''}{lead.brief?.level ? ` · ${lead.brief.level}` : ''}{lead.brief?.minutes ? ` · ${lead.brief.minutes} min` : ''}</p>
                <h2 class="home-hero-t"><a href={lead.link} target="_blank" rel="noopener noreferrer" data-read>{lead.title}</a></h2>
                {(lead.learn || (lead.brief?.kind && KIND[lead.brief.kind].intent)) && <p class="home-hero-learn">{lead.learn ?? KIND[lead.brief!.kind].intent}</p>}
                <p class="home-hero-src">{lead.feedTitle} · {categoryShort(lead.category)}</p>
                <div class="home-actions">
                    <a class="home-btn primary" href={lead.link} target="_blank" rel="noopener noreferrer" data-read>Read it</a>
                    <a class="home-btn" href={u('/digest/')}>Today's reading plan</a>
                </div>
            </section>
        )}

        <!-- ===== Time budget ===== -->
        {budgetPool.length > 0 && (
            <section class="tb home-tb" aria-label="Time budget">
                <div class="tb-bar" role="group" aria-label="How much time do you have?">
                    <span class="home-tb-k">Less time? Pick what fits:</span>
                    {[15, 30, 60].map(m => <button type="button" class="tb-chip" data-budget={m} aria-pressed="false">{m === 60 ? '1 hour' : `${m} min`}</button>)}
                </div>
                <ol class="tb-list" data-budget-list hidden></ol>
                <script type="application/json" id="budget-pool" set:html={JSON.stringify(budgetPool)} />
            </section>
        )}

        <!-- ===== The six parts as cards: a line on what's inside, 2–3 headlines, "Open" ===== -->
        <div class="home-grid">
            {cards.map(c => (
                <section class="home-card" aria-labelledby={`card-${c.slug}`}>
                    <header class="home-card-h">
                        <h2 id={`card-${c.slug}`}><a href={u(c.href)}>{c.title}</a></h2>
                        <p>{c.sub}</p>
                    </header>
                    {c.items.length === 0 ? <p class="home-empty">{c.empty}</p> : (
                        <ul class="home-items" role="list">
                            {c.items.map(x => (
                                <li><a href={x.href} target={x.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" data-read>{x.title}</a><span>{x.meta}</span></li>
                            ))}
                        </ul>
                    )}
                    <a class="home-open" href={u(c.href)}>Open {c.title} →</a>
                </section>
            ))}
        </div>
    </div>
    <ReadingClient />
</Base>


<script>
    import { getHistory } from '../lib/history-client';
    // ---------- Time budget: best unread pieces that fit, one per desk first (remembered for today) ----------
    {
        type P = { u: string; t: string; m: number; k: string; d: string };
        const pool: P[] = (() => { try { return JSON.parse(document.getElementById('budget-pool')?.textContent ?? '[]'); } catch { return []; } })();
        const list = document.querySelector<HTMLOListElement>('[data-budget-list]');
        const today = new Date().toDateString();
        const pick = (mins: number) => {
            const read = new Set(getHistory().map(r => r.u));
            const fresh = pool.filter(p => !read.has(p.u) && p.m <= mins);
            const out: P[] = [], desks = new Set<string>();
            let used = 0;
            for (const pass of [0, 1]) for (const p of fresh) {
                if (out.includes(p) || used + p.m > mins || (pass === 0 && desks.has(p.d))) continue;
                out.push(p); desks.add(p.d); used += p.m;
            }
            return { out, used };
        };
        const show = (mins: number | null) => {
            document.querySelectorAll<HTMLButtonElement>('[data-budget]').forEach(b => b.setAttribute('aria-pressed', String(Number(b.dataset.budget) === mins)));
            try { localStorage.setItem('budget:day', JSON.stringify(mins ? { day: today, mins } : {})); } catch {}
            if (!list) return;
            if (!mins) { list.hidden = true; list.innerHTML = ''; return; }
            const { out, used } = pick(mins);
            const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
            list.innerHTML = out.length
                ? out.map(p => `<li><a href="${esc(p.u)}" target="_blank" rel="noopener noreferrer" data-read>${esc(p.t)}</a> <span class="tb-meta">${esc(p.k)} · ${esc(p.d)} · ${p.m} min</span></li>`).join('') + `<li class="tb-sum">${used} of ${mins} minutes</li>`
                : '<li class="tb-sum">Nothing unread fits; try a longer slot.</li>';
            list.hidden = false;
        };
        document.querySelectorAll<HTMLButtonElement>('[data-budget]').forEach(b => b.addEventListener('click', () => {
            const m = Number(b.dataset.budget);
            show(b.getAttribute('aria-pressed') === 'true' ? null : m);
        }));
        try { const saved = JSON.parse(localStorage.getItem('budget:day') ?? '{}'); if (saved.day === today && saved.mins) show(saved.mins); } catch {}
    }

</script>
