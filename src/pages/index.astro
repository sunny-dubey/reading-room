---
// The front page: masthead, the time budget, a link to Today's summary, and six short boxes (≤3 items each)
// that open the part pages. The full bands live in src/components/Edition.astro.
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Gets from '../components/Gets.astro';
import ReadingClient from '../components/ReadingClient.astro';
import { categoryShort } from '../lib/feeds';
import { editionName, istTime, istDate, EDITION_WINDOW } from '../lib/edition';
import { getReading, rank } from '../lib/reading';
import { getOutages } from '../lib/outages';
import { getBriefing } from '../lib/briefing';
import { getPuzzles } from '../lib/puzzles';
import { getGitHub } from '../lib/github';
import { KIND } from '../lib/summarize';
import { getBusiness, outlet } from '../lib/business';
import { getCommunities } from '../lib/communities';
import { getStartups } from '../lib/startups';

const { learning, fetchedAt, now, deepCands, wire, topStories, roadmap, bigtech, experimental, research, thoughts } = await getReading();
const su = await getStartups();
const pz = await getPuzzles();
const bf = await getBriefing();
const outages = await getOutages();
// Incidents with an update in the edition window, lessons (a stated cause or a postmortem) first.
const lastUpdate = (i: { start: number; updates: { at: number }[] }) => Math.max(i.start, ...i.updates.map(x => x.at));
const recentLessons = outages.incidents.filter(i => now - lastUpdate(i) < EDITION_WINDOW)
    .sort((a, b) => Number(!!(b.cause || b.rca)) - Number(!!(a.cause || a.rca)) || lastUpdate(b) - lastUpdate(a)).slice(0, 3);
const gh = await getGitHub(now, roadmap);
const biz = await getBusiness();
const cm = await getCommunities(now, roadmap);
// Time budget: the edition's worthwhile pieces with a known reading time, best first (picked in the browser).
const budgetPool = learning.filter(i => +i.date <= now && now - +i.date < EDITION_WINDOW && (i.brief?.worth ?? 0) >= 3 && (i.brief?.minutes ?? 0) > 0 && !i.hype)
    .sort((a, b) => rank(b, now) - rank(a, now)).slice(0, 60)
    .map(i => ({ u: i.link, t: i.title, m: i.brief!.minutes, k: i.brief?.kind ? KIND[i.brief.kind].label : '', d: categoryShort(i.category) }));
const issue = Math.floor((+fetchedAt - Date.UTC(2026, 10, 17)) / 864e5) + 1; // No. 1 = the site's first day
---
<Base description="Learn something real every day: distributed systems, architecture, AI engineering, ML, security and maths." accent="reading">
    <div class="rd fp calm">
        <!-- ===== Masthead ===== -->
        <header class="fp-mast">
            <h1 class="fp-title">The Reading Room</h1>
            <p class="fp-for">A reading and discovery room for careers in software and the industries around it, edited by a local AI.</p>
            <div class="fp-dateline">
                <span>No. {issue}</span>
                <span data-edition-date={fetchedAt.toISOString()}>{istDate(fetchedAt)}</span>
                <span>{editionName(fetchedAt)} edition · <time data-edition-time datetime={fetchedAt.toISOString()}>{istTime(fetchedAt)}</time></span>
            </div>
            <p class="fp-stale" data-stale={fetchedAt.toISOString()} hidden></p>
            <p class="fp-since" data-since hidden></p>
        </header>
        <!-- ===== Time budget: pick how long you have; the browser assembles the best unread reads that fit ===== -->
        {budgetPool.length > 0 && (
            <section class="tb" aria-label="Time budget">
                <div class="tb-bar" role="group" aria-label="How much time do you have?">
                    <span class="tb-k">How long do you have?</span>
                    {[15, 30, 60].map(m => <button type="button" class="tb-chip" data-budget={m} aria-pressed="false">{m === 60 ? '1 hour' : `${m} min`}</button>)}
                </div>
                <ol class="tb-list" data-budget-list hidden></ol>
                <script type="application/json" id="budget-pool" set:html={JSON.stringify(budgetPool)} />
            </section>
        )}


        <p class="fp-digest"><a href={u('/digest/')}>Today's summary: a reading plan and the edition in one page →</a></p>

        <!-- ===== The six parts, short: three items each, then the part's own page ===== -->
        {(() => {
            const Part = (n: number, title: string, href: string, sub: string, children: any) => (
                <section class="fp-sum" aria-labelledby={`sum-${n}`}>
                    <header class="fp-sum-h"><span class="fp-part-n">{n}</span><h2 id={`sum-${n}`}><a href={u(href)}>{title}</a></h2><span class="fp-part-sub">{sub}</span><a class="fp-sum-open" href={u(href)}>Open {title} →</a></header>
                    {children}
                </section>
            );
            const Line = ({ href, k, title, note }: { href: string; k: string; title: string; note?: string }) => (
                <li><p class="fp-sum-k">{k}</p><a class="fp-sum-t" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" data-read>{title}</a>{note && <p class="fp-sum-note">{note}</p>}</li>
            );
            const lead = deepCands[0];
            const discoverLines = [
                ...su.targets.slice(0, 1).map(t => ({ href: t.url, k: `${t.kind === 'funding' ? 'Just raised' : t.kind === 'hiring' ? 'Hiring now' : 'YC launch'} · ${t.signal}`, title: t.name, note: `How to approach: ${t.approach.mention}` })),
                ...bigtech.day.slice(0, 1).map(i => ({ href: i.link, k: `Big tech · ${i.feedTitle}`, title: i.title, note: i.learn })),
                ...(gh.featured ? [{ href: gh.featured.url, k: `On GitHub · ${gh.featured.language || 'code'}`, title: gh.featured.name, note: gh.featured.description }] : []),
                ...cm.everywhere.slice(0, 1).map(g => ({ href: g.threads[0].ext ?? g.threads[0].url, k: `In ${new Set(g.threads.map(t => t.community)).size} communities`, title: g.threads[0].title })),
            ].slice(0, 3);
            const newsLines = [
                ...[...biz.top, ...biz.river].slice(0, 1).map(b => ({ href: b.lead.link, k: `Business · ${outlet(b.lead)}`, title: b.lead.title })),
                ...wire.filter(i => !i.hype).slice(0, 1).map(i => ({ href: i.link, k: `The wire · ${categoryShort(i.category)}`, title: i.title })),
                ...[...bf.standards.slice(0, 1).map(x => ({ href: x.url, k: `Standards · ${x.kind === 'Release' ? x.who : x.kind}`, title: x.title })), ...recentLessons.slice(0, 1).map(i => ({ href: i.url, k: `Incident · ${i.provider}`, title: i.title }))].slice(0, 1),
            ];
            return <div class="fp-sums">
                {Part(1, 'Discover', '/discover/', "what's new and worth knowing", <>
                    <ol class="fp-sum-list" role="list">{discoverLines.map(x => Line(x))}</ol>
                </>)}
                {Part(2, 'Learn', '/learn/', "the clearest pieces of the day", <>
                    {lead && (
                        <article class="fp-sum-lead" data-link={lead.link}>
                            <a class="fp-sum-lead-t" href={lead.link} target="_blank" rel="noopener noreferrer" data-read>{lead.title}</a>
                            <Gets i={lead} />
                        </article>
                    )}
                    <ol class="fp-sum-list" role="list">{topStories.slice(0, 2).map(i => Line({ href: i.link, k: `${categoryShort(i.category)} · ${i.feedTitle}`, title: i.title, note: i.learn }))}</ol>
                </>)}
                {Part(3, 'News', '/news/', "what changed in the world your code runs in", <>
                    <ol class="fp-sum-list" role="list">{newsLines.map(x => Line(x))}</ol>
                </>)}
                {Part(4, 'Try it', '/try/', "hands-on pieces and the puzzle", <>
                    <ol class="fp-sum-list" role="list">
                        {experimental.slice(0, 2).map(i => Line({ href: i.link, k: `${i.brief?.kind ? KIND[i.brief.kind].label : 'How-to'} · ${i.feedTitle}`, title: i.title, note: i.learn }))}
                        {pz.today && Line({ href: u('/try/'), k: "Today's puzzle", title: pz.today.title })}
                    </ol>
                </>)}
                {Part(5, 'Research', '/papers/', "new papers, in plain words first", <>
                    <ol class="fp-sum-list" role="list">{research.slice(0, 3).map(i => Line({ href: i.link, k: `${categoryShort(i.category)} · ${i.feedTitle}`, title: i.title, note: i.paper?.gist }))}</ol>
                </>)}
                {Part(6, 'Thoughts', '/thoughts/', "essays and opinion, for perspective", <>
                    <ol class="fp-sum-list" role="list">{thoughts.slice(0, 3).map(i => Line({ href: i.link, k: i.feedTitle, title: i.title }))}</ol>
                    {thoughts.length === 0 && <p class="fp-empty">No essays in the last 24 hours.</p>}
                </>)}
            </div>;
        })()}
    </div>
    <ReadingClient />
</Base>


<script>
    import { getHistory } from '../lib/history-client';
    // ---------- Time budget: best unread pieces that fit, one per desk first (remembered for today) ----------
    {
        type P = { u: string; t: string; m: number; k: string; d: string };
        const pool: P[] = (() => { try { return JSON.parse(document.getElementById('budget-pool')?.textContent ?? '[]'); } catch { return []; } })();
        const list = document.querySelector<HTMLOListElement>('[data-budget-list]');
        const today = new Date().toDateString();
        const pick = (mins: number) => {
            const read = new Set(getHistory().map(r => r.u));
            const fresh = pool.filter(p => !read.has(p.u) && p.m <= mins);
            const out: P[] = [], desks = new Set<string>();
            let used = 0;
            for (const pass of [0, 1]) for (const p of fresh) {
                if (out.includes(p) || used + p.m > mins || (pass === 0 && desks.has(p.d))) continue;
                out.push(p); desks.add(p.d); used += p.m;
            }
            return { out, used };
        };
        const show = (mins: number | null) => {
            document.querySelectorAll<HTMLButtonElement>('[data-budget]').forEach(b => b.setAttribute('aria-pressed', String(Number(b.dataset.budget) === mins)));
            try { localStorage.setItem('budget:day', JSON.stringify(mins ? { day: today, mins } : {})); } catch {}
            if (!list) return;
            if (!mins) { list.hidden = true; list.innerHTML = ''; return; }
            const { out, used } = pick(mins);
            const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
            list.innerHTML = out.length
                ? out.map(p => `<li><a href="${esc(p.u)}" target="_blank" rel="noopener noreferrer" data-read>${esc(p.t)}</a> <span class="tb-meta">${esc(p.k)} · ${esc(p.d)} · ${p.m} min</span></li>`).join('') + `<li class="tb-sum">${used} of ${mins} minutes</li>`
                : '<li class="tb-sum">Nothing unread fits; try a longer slot.</li>';
            list.hidden = false;
        };
        document.querySelectorAll<HTMLButtonElement>('[data-budget]').forEach(b => b.addEventListener('click', () => {
            const m = Number(b.dataset.budget);
            show(b.getAttribute('aria-pressed') === 'true' ? null : m);
        }));
        try { const saved = JSON.parse(localStorage.getItem('budget:day') ?? '{}'); if (saved.day === today && saved.mins) show(saved.mins); } catch {}
    }

</script>
