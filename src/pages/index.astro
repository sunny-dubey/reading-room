---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Story from '../components/Story.astro';
import Cover from '../components/Cover.astro';
import { categoryShort } from '../lib/feeds';
import { editionName, istTime, istDate } from '../lib/edition';
import ReadingClient from '../components/ReadingClient.astro';
import { getReading, getCanon, getRevisit, rank, isDeep } from '../lib/reading';
import { getToday } from '../lib/today';
import { getOutages, fmtDuration } from '../lib/outages';
import OutageMap from '../components/OutageMap.astro';

const { learning, fetchedAt, now, deepRead, deepCands, fresh, picks, postmortem, tracks, pulse, startups, roadmap } = await getReading();
const canon = await getCanon();
const { question, rabbitHoles, twoTakes, quickCands, explainer, readMap } = await getToday();
const STEP_NAMES = ['Start here', 'Go deeper', 'Master it'];
const ROMAN = ['I', 'II', 'III'];
// Outage map panel: the last 72 hours (a week if it's been quiet).
const outages = await getOutages();
const recentOut = (h: number) => outages.incidents.filter(i => outages.now - i.start < h * 3600e3);
const outWindow = recentOut(72).length >= 3 ? 72 : 168;
const outShown = recentOut(outWindow);
const outAnchor = (id: string) => `inc-${id.replace(/[^a-z0-9]+/gi, '-')}`;
const issue = Math.floor((+fetchedAt - Date.UTC(2026, 10, 17)) / 864e5) + 1; // No. 1 = the site's first day
const mins = (m?: number) => (m ? `${m} min` : '');
const revisit = await getRevisit(now);
const today = fetchedAt.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
const deepCount = tracks.reduce((a, t) => a + t.deep.length, 0);
const newReads = learning.filter(i => +i.date > +fetchedAt - 6 * 3600e3 && +i.date <= +fetchedAt).length;
const hours = (m: number) => m >= 90 ? `${Math.round(m / 60)} h` : `${m} min`;

// ---------- Today's plan: read → canon → reflect/revisit ----------
const canonPlan = canon.filter(t => t.items.length).map(t => ({
    track: t.short, cat: t.id,
    items: t.items.map(c => ({ id: c.id, title: c.data.title, url: c.data.url, minutes: c.data.minutes })),
}));
const revisitItem = revisit.week[0] ?? revisit.month[0] ?? revisit.archive;
const planMinutes = (deepRead?.brief?.minutes ?? 15) + 25 + 10;

// ---------- This week's design practice (rotates every Monday, IST) ----------
const IST = 5.5 * 3600e3;
const week = Math.floor((now + IST + 3 * 864e5) / (7 * 864e5)); // weeks since epoch, Monday-based
const practice = roadmap.practice.length ? roadmap.practice[week % roadmap.practice.length] : undefined;
// Plus the best recent article that teaches one of the exercise's topics.
const practiceFresh = practice?.topics.flatMap(t => roadmap.itemsByTopic.get(t.id) ?? [])
    .filter(i => isDeep(i) && (i.skill?.sim ?? 0) >= 0.5)
    .sort((a, b) => rank(b, now) - rank(a, now))[0];
---
<Base description="Learn something real every day: distributed systems, architecture, AI engineering, ML, security and maths." accent="reading">
    <div class="rd fp">
        <!-- ===== Masthead ===== -->
        <header class="fp-mast">
            <div class="fp-ears">
                <div class="fp-ear">
                    <span class="fp-ear-k">Your streak</span>
                    <span class="fp-ear-v"><span data-ear-streak>Open a read to start one</span></span>
                </div>
                <div class="fp-ear right">
                    <span class="fp-ear-k">This edition</span>
                    <span class="fp-ear-v">{newReads === 0 ? 'No new reads since the last edition' : `${newReads} new ${newReads === 1 ? 'read' : 'reads'} since the last edition`} · <span data-next-edition>next in 3 hours</span></span>
                </div>
            </div>
            <h1 class="fp-title">The Reading Room</h1>
            <div class="fp-dateline">
                <span>No. {issue}</span>
                <span data-edition-date={fetchedAt.toISOString()}>{istDate(fetchedAt)}</span>
                <span>{editionName(fetchedAt)} edition · <time data-edition-time datetime={fetchedAt.toISOString()}>{istTime(fetchedAt)}</time></span>
            </div>
        </header>

        <section class="week-card" data-your-week hidden aria-label="Your week"></section>

        <!-- ===== Front: the lead story and the day's plan ===== -->
        <section class="fp-front">
            {deepRead && (
                <div class="fp-lead-wrap">
                    {deepCands.map((d, n) => (
                        <article class="fp-lead" data-deep-lead={d.link} data-link={d.link} data-cat={d.category} hidden={n > 0}>
                            <p class="fp-kicker">The deep read · {categoryShort(d.category)} · {mins(d.brief?.minutes)}</p>
                            <h2 class:list={["fp-lead-h", { long: d.title.length > 60 }]}><a href={d.link} target="_blank" rel="noopener noreferrer" data-read>{d.title}</a></h2>
                            {d.skill && <p class="fp-deck">You'll get better at <a href={u(`/roadmap/#${d.skill.topic.id}`)}>{d.skill.topic.name}</a>. {d.skill.topic.why}</p>}
                            <p class="fp-byline">By {d.feedTitle}</p>
                            <a href={d.link} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><Cover seed={d.title} track={d.category} w={640} h={280} class="fp-lead-art" /></a>
                            {d.classic && <p class="fp-footnote"><span>Builds on a classic</span><a href={d.classic.url} target="_blank" rel="noopener noreferrer">{d.classic.title}</a>, {d.classic.author}</p>}
                        </article>
                    ))}
                </div>
            )}

            <aside class="fp-side">
                <section class="plan" data-plan>
                    <header class="plan-head">
                        <h2>Today's plan</h2>
                        <span class="plan-time" data-plan-time>about {planMinutes} min</span>
                        <div class="plan-modes" role="group" aria-label="How much time do you have today?">
                            <button type="button" data-mode="quick">15 min</button>
                            <button type="button" data-mode="hour" aria-pressed="true">1 hour</button>
                            <button type="button" data-mode="weekend">Weekend</button>
                        </div>
                    </header>
                    <ol class="plan-steps" role="list">
                        {deepRead && (
                            <li class="plan-step" data-step="read" data-link={deepRead.link} data-modes="hour weekend" data-min={deepRead.brief?.minutes ?? 15}>
                                <label class="plan-check"><input type="checkbox" data-plan-step="read" aria-label="Done: read" /><span></span></label>
                                {deepCands.map((d, n) => (
                                    <div data-deep-cand={d.link} data-min={d.brief?.minutes ?? 15} hidden={n > 0}>
                                        <span class="plan-kind">Read the lead story</span>
                                        <a class="plan-title" href={d.link} target="_blank" rel="noopener noreferrer" data-read>{d.title}</a>
                                        <span class="plan-meta">{d.feedTitle}{d.brief?.minutes ? ` · ${d.brief.minutes} min` : ''}</span>
                                    </div>
                                ))}
                            </li>
                        )}
                        {quickCands.length > 0 && (
                            <li class="plan-step" data-step="quick" data-modes="quick" data-min={quickCands[0].brief?.minutes ?? 8} hidden>
                                <label class="plan-check"><input type="checkbox" data-plan-step="quick" aria-label="Done: quick read" /><span></span></label>
                                {quickCands.map((d, n) => (
                                    <div data-quick-cand={d.link} data-min={d.brief?.minutes ?? 8} hidden={n > 0}>
                                        <span class="plan-kind">A quick, good read</span>
                                        <a class="plan-title" href={d.link} target="_blank" rel="noopener noreferrer" data-read>{d.title}</a>
                                        <span class="plan-meta">{d.feedTitle}{d.brief?.minutes ? ` · ${d.brief.minutes} min` : ''}</span>
                                    </div>
                                ))}
                            </li>
                        )}
                        <li class="plan-step" data-step="canon" data-modes="hour weekend" data-min="25">
                            <label class="plan-check"><input type="checkbox" data-plan-step="canon" aria-label="Done: canon" /><span></span></label>
                            <div>
                                <span class="plan-kind">A foundation (the Canon)</span>
                                <a class="plan-title" data-plan-canon href={u('/canon/')} target="_blank" rel="noopener noreferrer">Next foundational read</a>
                                <span class="plan-meta" data-plan-canon-meta>Read 25 minutes of it; it doesn't have to be finished today</span>
                            </div>
                        </li>
                        {practice && (
                            <li class="plan-step" data-step="practice" data-modes="weekend" data-min="40" hidden>
                                <label class="plan-check"><input type="checkbox" data-plan-step="practice" aria-label="Done: design practice" /><span></span></label>
                                <div>
                                    <span class="plan-kind">Design practice</span>
                                    <a class="plan-title" href="#practice">{practice.name}</a>
                                    <span class="plan-meta">30–45 min on paper</span>
                                </div>
                            </li>
                        )}
                        <li class="plan-step" data-step="explain" data-modes="quick hour weekend" data-min="10">
                            <label class="plan-check"><input type="checkbox" data-plan-step="explain" aria-label="Done: reflect or revisit" /><span></span></label>
                            <div>
                                {revisitItem ? (
                                    <>
                                        <span class="plan-kind">Revisit what you wrote</span>
                                        <a class="plan-title" href={u(revisitItem.href)}>{revisitItem.title}</a>
                                        <span class="plan-meta">Re-read it, then fix or extend it.</span>
                                    </>
                                ) : (
                                    <div data-reflect>
                                        <span class="plan-kind">Reflect</span>
                                        <span class="plan-title">Explain the lead story to a teammate</span>
                                        <span class="plan-meta">Ten minutes, in your own words. If you can say it simply, you understand it.</span>
                                    </div>
                                )}
                            </div>
                        </li>
                    </ol>
                    <p class="stamp" data-plan-done hidden>Done for today</p>
                    <script type="application/json" id="plan-canon" set:html={JSON.stringify(canonPlan)} />
                </section>

                {question && (
                    <section class="fp-box qotd">
                        <h3 class="fp-box-h">Question of the day</h3>
                        <p class="qotd-q">{question.q}</p>
                        {question.hint && <details class="qotd-hint"><summary>Need a hint?</summary><p>{question.hint}</p></details>}
                        {(question.canon || question.read || question.topic) && (
                            <p class="qotd-reads"><span>Find the answer in</span>
                                {question.canon && <a href={question.canon.data.url} target="_blank" rel="noopener noreferrer">{question.canon.data.title}</a>}
                                {question.read && <a href={question.read.link} target="_blank" rel="noopener noreferrer">{question.read.title}</a>}
                                {question.topic && <a href={u(`/roadmap/#${question.topic.id}`)}>{question.topic.name} on the Roadmap</a>}
                            </p>
                        )}
                    </section>
                )}

                <section class="fp-box reading-pulse" data-reading-pulse aria-label="Your reading">
                    <h3 class="fp-box-h">Your reading</h3>
                    <div class="rp-stats">
                        <div><strong data-rp-streak>0</strong><span>day streak</span></div>
                        <div><strong data-rp-month>0</strong><span>reads, 30 days</span></div>
                        <div><strong data-rp-topics>0</strong><span>topics</span></div>
                        <div><strong data-rp-tracks>0</strong><span>tracks</span></div>
                    </div>
                    <div class="rp-grid" data-rp-grid aria-hidden="true"></div>
                    <p class="rp-note" data-rp-note>From this browser only. Open a read to start your streak.</p>
                    <script type="application/json" id="read-map" set:html={JSON.stringify(readMap)} />
                </section>
            </aside>
        </section>

        <!-- ===== Fresh this week ===== -->
        {fresh.length > 0 && (
            <section class="fp-band reveal">
                <h2 class="fp-band-h"><span>Fresh this week</span></h2>
                <div class="fp-cols">{fresh.map(i => <Story i={i} cover />)}</div>
            </section>
        )}

        <!-- ===== The outage map ===== -->
        {outages.incidents.length > 0 && (
            <section class="fp-band reveal out-front">
                <h2 class="fp-band-h"><span>The outage map</span></h2>
                <div class="out-front-grid">
                    <OutageMap incidents={outShown} now={outages.now} size="small" />
                    <div class="out-front-side">
                        <p class="out-front-stats">
                            <strong>{outages.stats.week}</strong> incidents this week{outages.stats.ongoing ? <> · <strong class="live">{outages.stats.ongoing} ongoing</strong></> : ''}
                            {outages.stats.longest && <> · longest <strong>{fmtDuration(outages.stats.longest.duration)}</strong> ({outages.stats.longest.provider})</>}
                        </p>
                        <ul class="out-latest" role="list">
                            {outShown.slice(0, 4).map(i => (
                                <li class:list={[`sev-${i.severity}`, { ongoing: i.ongoing }]}>
                                    <a href={u(`/outages/#${outAnchor(i.id)}`)}>
                                        <span class="out-latest-t"><b>{i.provider}</b> · {i.title}</span>
                                        <span class="story-by">{i.places[0]?.name ?? 'Global'} · <time data-rel datetime={new Date(i.start).toISOString()}></time>{i.ongoing ? ' · ongoing' : i.duration ? ` · ${fmtDuration(i.duration)}` : ''}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                        {outages.featured && <p class="out-front-inv"><span>Investigation of the week</span><a href={u(`/outages/#${outAnchor(outages.featured.id)}`)}>{outages.featured.provider}: {outages.featured.title}</a></p>}
                        <a class="fp-more" href={u('/outages/')}>Open the full map and every investigation →</a>
                    </div>
                </div>
            </section>
        )}

        <!-- ===== The rabbit hole ===== -->
        {rabbitHoles.length > 0 && (
            <section class="fp-band reveal" data-rabbit>
                <h2 class="fp-band-h"><span>The rabbit hole</span></h2>
                {rabbitHoles.map((h, n) => (
                    <div class="fp-feature" data-hole={h.topic.id} data-cat={h.topic.track} hidden={n > 0}>
                        <div class="fp-feature-intro">
                            <p class="fp-kicker">{h.topic.areaTitle}</p>
                            <h3 class="fp-feature-h"><a href={u(`/roadmap/#${h.topic.id}`)}>{h.topic.name}</a></h3>
                            <p class="fp-deck">{h.topic.why}</p>
                        </div>
                        <ol class="fp-steps" role="list">
                            {h.steps.map((st, k) => (
                                <li data-link={st.url}>
                                    <span class="fp-roman">{ROMAN[k]}</span>
                                    <span class="fp-kicker sm">{STEP_NAMES[k]}</span>
                                    <a href={st.url} target="_blank" rel="noopener noreferrer" data-read>{st.title}</a>
                                    <span class="story-by">{st.kind === 'canon' ? 'From the Canon · ' : ''}{st.meta}</span>
                                </li>
                            ))}
                        </ol>
                    </div>
                ))}
            </section>
        )}

        <!-- ===== Point · Counterpoint ===== -->
        {twoTakes && (
            <section class="fp-band reveal">
                <h2 class="fp-band-h"><span>Point · Counterpoint</span></h2>
                <p class="fp-pc-topic">Two takes on <a href={u(`/roadmap/#${twoTakes.topic.id}`)}>{twoTakes.topic.name}</a></p>
                <div class="fp-pc">
                    <Story i={twoTakes.a} size="take" kicker={twoTakes.a.feedTitle} />
                    <span class="fp-vs" aria-hidden="true">vs</span>
                    <Story i={twoTakes.b} size="take" kicker={twoTakes.b.feedTitle} />
                </div>
                <p class="fp-pc-ask">Read both. Where do they agree, where do they differ, and why?</p>
            </section>
        )}

        <!-- ===== The weekly problem ===== -->
        {practice && (
            <section class="practice reveal" id="practice" data-practice={`${practice.id}-w${week}`}>
                <div class="practice-head">
                    <span class="practice-label">The weekly problem</span>
                    <label class="practice-done"><input type="checkbox" data-practice-check /> Done</label>
                </div>
                <h2 class="practice-title">{practice.name}</h2>
                {practice.twist && <p class="practice-twist dropcap">{practice.twist}</p>}
                <p class="practice-how">30–45 minutes, on paper or a whiteboard. Work through it in order:</p>
                <ol class="practice-steps">
                    <li><strong>Requirements:</strong> who uses it, what must it do, what must it never do</li>
                    <li><strong>Estimates:</strong> requests per second, data size, read/write ratio</li>
                    <li><strong>API and data model</strong></li>
                    <li><strong>High-level design:</strong> boxes and arrows, the request path end to end</li>
                    <li><strong>Bottlenecks and trade-offs:</strong> what breaks at 10×, what you'd change</li>
                </ol>
                {practice.topics.length > 0 && (
                    <p class="practice-links"><span>Exercises</span>{practice.topics.map(t => <a href={u(`/roadmap/#${t.id}`)}>{t.name}</a>)}</p>
                )}
                {(practice.canon.length > 0 || practiceFresh) && (
                    <p class="practice-links"><span>Read first</span>
                        {practice.canon.map(c => <a href={c.data.url} target="_blank" rel="noopener noreferrer" title={`${c.data.author} · ${c.data.minutes} min`}>{c.data.title}</a>)}
                        {practiceFresh && <a href={practiceFresh.link} target="_blank" rel="noopener noreferrer" title={`New · ${practiceFresh.feedTitle}${practiceFresh.brief?.minutes ? ` · ${practiceFresh.brief.minutes} min` : ''}`}>{practiceFresh.title}</a>}
                    </p>
                )}
            </section>
        )}

        <!-- ===== From the Canon ===== -->
        <section class="fp-band reveal">
            <h2 class="fp-band-h"><span>From the Canon</span></h2>
            <div class="next-grid">
                {canon.filter(t => t.items.length).map(t => (
                    <div class="next-card" data-next-track={t.id} data-cat={t.id}>
                        <div class="next-top">
                            <a class="story-cat" data-cat={t.id} href={u(`/${t.slug}/#canon`)}>{t.short}</a>
                            <span class="next-progress" data-next-progress></span>
                        </div>
                        {t.items.map(c => (
                            <div class="next-item" data-next-id={c.id} data-link={c.data.url} hidden>
                                <a class="next-title" href={c.data.url} target="_blank" rel="noopener noreferrer" data-read>{c.data.title}</a>
                                <p class="next-why">{c.data.why}</p>
                                {c.data.parts && <p class="next-part" data-next-part={c.id} hidden></p>}
                                <div class="next-foot">
                                    <span>{c.data.author} · {c.data.kind} · {hours(c.data.minutes)}</span>
                                    <button type="button" class="mark-done" data-mark-done={c.id}>Mark done ✓</button>
                                </div>
                            </div>
                        ))}
                        <p class="next-item" data-next-done hidden>Track complete. Go deeper with the fresh reads in <a class="u" href={u(`/${t.slug}/`)}>{t.short}</a>.</p>
                    </div>
                ))}
            </div>
            <p class="fp-more-link"><a href={u('/canon/')}>The whole Canon →</a></p>
        </section>

        <!-- ===== More worth your time ===== -->
        {picks.length > 0 && (
            <section class="fp-band reveal">
                <h2 class="fp-band-h"><span>More worth your time</span></h2>
                <div class="fp-briefs-grid">{picks.map(i => <Story i={i} size="brief" deck={false} />)}</div>
            </section>
        )}

        <!-- ===== Bottom row ===== -->
        <section class="fp-band fp-bottom reveal">
            {postmortem && (
                <div class="fp-cell" data-link={postmortem.link} data-cat="postmortems">
                    <h3 class="fp-box-h">Learn from failure</h3>
                    <a href={postmortem.link} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><Cover seed={postmortem.title} track="postmortems" w={320} h={120} /></a>
                    <a class="fp-cell-h" href={postmortem.link} target="_blank" rel="noopener noreferrer" data-read>{postmortem.title}</a>
                    <p class="story-by">{postmortem.feedTitle}{postmortem.brief?.minutes ? ` · ${postmortem.brief.minutes} min` : ''}</p>
                    <a class="fp-more" href={u('/postmortems/')}>More postmortems →</a>
                </div>
            )}
            {explainer && (
                <div class="fp-cell" data-cat={explainer.track} data-link={explainer.url}>
                    <h3 class="fp-box-h">See it, don't just read it</h3>
                    <a href={explainer.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><Cover seed={explainer.title} track={explainer.track} w={320} h={120} /></a>
                    <a class="fp-cell-h" href={explainer.url} target="_blank" rel="noopener noreferrer" data-read>{explainer.title}</a>
                    <p class="fp-cell-p">{explainer.why}</p>
                    <p class="story-by">{explainer.author} · {explainer.minutes} min · interactive</p>
                </div>
            )}
            <div class="fp-cell" data-revisit hidden={revisit.week.length + revisit.month.length === 0 && !revisit.archive}>
                <h3 class="fp-box-h">Revisit</h3>
                <ul class="mini revisit" role="list" data-revisit-list>
                    {revisit.week.map(e => <li><a href={u(e.href)}><span class="mini-title">{e.title}</span><span class="mini-meta">your note · 1 week ago</span></a></li>)}
                    {revisit.month.map(e => <li><a href={u(e.href)}><span class="mini-title">{e.title}</span><span class="mini-meta">your note · 1 month ago</span></a></li>)}
                    {revisit.archive && <li><a href={u(revisit.archive.href)}><span class="mini-title">{revisit.archive.title}</span><span class="mini-meta">your note · from the archive</span></a></li>}
                </ul>
                <p class="revisit-hint">Can you still explain the core idea? If not, skim it again.</p>
            </div>
        </section>

        <!-- ===== Sections ===== -->
        <section class="fp-band reveal">
            <h2 class="fp-band-h"><span>Sections</span></h2>
            <div class="fp-sections">
                {tracks.map(t => (
                    <a class="fp-section" href={u(`/${t.slug}/`)} data-cat={t.id}>
                        <span class="fp-section-name"><span class="cat-dot" data-cat={t.id}></span>{t.label}</span>
                        <span class="fp-section-blurb">{t.blurb}</span>
                        <span class="story-by">{t.deep.length} deep reads · {canon.find(c => c.id === t.id)?.items.length ?? 0} in the Canon</span>
                    </a>
                ))}
            </div>
            <div class="fp-strips">
                {startups.launches.length > 0 && <a class="pulse-strip" href={u('/startups/')}><span class="pulse-label">Startups</span><span class="pulse-text">{startups.launches.length} recent YC launches, plus Show HN and Product Hunt.</span><span aria-hidden="true">→</span></a>}
                {pulse.length > 0 && <a class="pulse-strip" href={u('/pulse/')}><span class="pulse-label">Pulse</span><span class="pulse-text">The week in tech, in ten headlines.</span><span aria-hidden="true">→</span></a>}
            </div>
        </section>
    </div>
    <ReadingClient />
</Base>

<script>
    import { getSet } from '../lib/progress-client';
    import { mountReadingStats } from '../lib/reading-stats-client';
    import { dueForRevisit, getHistory } from '../lib/history-client';
    import { nextPart, partId } from '../lib/canon-parts-client';

    // ---------- Revisit from your reading history (spaced repetition, no writing needed) ----------
    const due = dueForRevisit();
    const esc = (t: string) => t.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const list = document.querySelector<HTMLElement>('[data-revisit-list]');
    const items = [...due.week.slice(0, 2).map(r => ({ r, when: 'you read it a week ago' })), ...due.month.slice(0, 2).map(r => ({ r, when: 'you read it a month ago' }))];
    if (list && items.length) {
        list.insertAdjacentHTML('afterbegin', items.map(({ r, when }) =>
            `<li><a href="${esc(r.u)}" target="_blank" rel="noopener noreferrer"><span class="mini-title">${esc(r.t)}</span><span class="mini-meta">${when}</span></a></li>`).join(''));
        document.querySelector<HTMLElement>('[data-revisit]')!.hidden = false;
    }
    // Plan step 3: if there's nothing of yours to revisit, offer something you read a week ago.
    const reflect = document.querySelector<HTMLElement>('[data-reflect]');
    const first = due.week[0] ?? due.month[0];
    if (reflect && first) {
        const ago = due.week[0] ? 'a week' : 'a month';
        reflect.innerHTML = `<span class="plan-kind">Revisit</span>
            <a class="plan-title" href="${esc(first.u)}" target="_blank" rel="noopener noreferrer">${esc(first.t)}</a>
            <span class="plan-meta">You read this ${ago} ago. Can you still explain the core idea? Skim it again if not.</span>`;
    }

    // ---------- This week's practice: a tick per week ----------
    const practice = document.querySelector<HTMLElement>('[data-practice]');
    const pcheck = document.querySelector<HTMLInputElement>('[data-practice-check]');
    if (practice && pcheck) {
        const pkey = `practice:${practice.dataset.practice}`;
        const paint = () => practice.classList.toggle('is-done', pcheck.checked);
        try { pcheck.checked = localStorage.getItem(pkey) === '1'; } catch {}
        paint();
        pcheck.addEventListener('change', () => { try { localStorage.setItem(pkey, pcheck.checked ? '1' : '0'); } catch {} paint(); });
    }

    // Today's plan: pick the next unfinished Canon item, rotating through tracks day by day,
    // and remember today's ticks (reset tomorrow).
    // Deep read: keep today's pick all day; otherwise the best one you haven't opened or been shown before.
    {
        const today = new Date().toLocaleDateString('en-CA');
        const SHOWN = 'plan:deep-shown';
        let shown: Record<string, string> = {};
        try { shown = JSON.parse(localStorage.getItem(SHOWN) ?? '{}'); } catch {}
        const read = new Set(getHistory().map(r => r.u));
        const cands = [...document.querySelectorAll<HTMLElement>('[data-deep-cand]')];
        const link = (c: HTMLElement) => c.dataset.deepCand!;
        const pick = cands.find(c => shown[link(c)] === today)
            ?? cands.find(c => !read.has(link(c)) && !shown[link(c)])
            ?? cands.find(c => !read.has(link(c)))
            ?? cands[0];
        if (pick) {
            cands.forEach(c => (c.hidden = c !== pick));
            document.querySelectorAll<HTMLElement>('[data-deep-lead]').forEach(l => (l.hidden = l.dataset.deepLead !== link(pick)));
            const li = pick.closest<HTMLElement>('[data-step="read"]');
            if (li) { li.dataset.link = link(pick); li.classList.toggle('is-read', read.has(link(pick))); }
            shown[link(pick)] ??= today;
            const cutoff = new Date(Date.now() - 60 * 864e5).toLocaleDateString('en-CA');
            for (const [k, d] of Object.entries(shown)) if (d < cutoff) delete shown[k];
            try { localStorage.setItem(SHOWN, JSON.stringify(shown)); } catch {}
            // Don't show the same piece twice on the page.
            if (pick !== cands[0]) document.querySelectorAll<HTMLElement>('[data-story]').forEach(el => { if (el.dataset.link === link(pick)) el.hidden = true; });
        }
    }

    const key = `plan:${new Date().toLocaleDateString('en-CA')}`;
    const readSet = (k: string) => { try { return new Set<string>(JSON.parse(localStorage.getItem(k) ?? '[]')); } catch { return new Set<string>(); } };
    const plan = JSON.parse(document.getElementById('plan-canon')?.textContent ?? '[]') as { track: string; cat: string; items: { id: string; title: string; url: string; minutes: number }[] }[];
    const canonDone = getSet('canon');
    const open = plan.filter(t => t.items.some(c => !canonDone.has(c.id)));
    const day = Math.floor(Date.now() / 864e5);
    const pickTrack = open.length ? open[day % open.length] : null;
    const next = pickTrack?.items.find(c => !canonDone.has(c.id));
    const link = document.querySelector<HTMLAnchorElement>('[data-plan-canon]');
    const meta = document.querySelector<HTMLElement>('[data-plan-canon-meta]');
    // A long work (book, course, long video) shows its next chapter, not the whole thing.
    function renderCanonStep() {
        if (!next || !link || !meta) return;
        const ch = nextPart(next.id);
        const url = ch ? ch.url : next.url;
        link.href = url;
        link.textContent = ch ? `${next.title}: ${ch.part.title}` : next.title;
        const m = ch ? ch.part.minutes : next.minutes;
        const len = m > 60 ? `${m} min, fine to split over a few days` : `${m} min`;
        meta.textContent = ch ? `${pickTrack!.track} · chapter ${ch.i + 1} of ${ch.n} · ${len} · ` : `${pickTrack!.track} · ${len}`;
        if (ch) {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'mark-done'; b.dataset.markDone = next.id; b.dataset.partDone = partId(next.id, ch.i);
            b.textContent = 'Finished chapter ✓';
            meta.append(b);
        }
        link.closest('li')?.setAttribute('data-link', url);
    }
    renderCanonStep();
    document.addEventListener('canon:changed', renderCanonStep);

    // ---------- Quick read (15-minute plan): the best short piece you haven't opened ----------
    {
        const read = new Set(getHistory().map(r => r.u));
        const cands = [...document.querySelectorAll<HTMLElement>('[data-quick-cand]')];
        const pick = cands.find(c => !read.has(c.dataset.quickCand!)) ?? cands[0];
        if (pick) {
            cands.forEach(c => (c.hidden = c !== pick));
            const li = pick.closest<HTMLElement>('li');
            if (li) { li.dataset.link = pick.dataset.quickCand!; li.dataset.min = pick.dataset.min!; }
        }
        const deep = [...document.querySelectorAll<HTMLElement>('[data-deep-cand]')].find(c => !c.hidden);
        const dli = deep?.closest<HTMLElement>('li');
        if (deep && dli) dli.dataset.min = deep.dataset.min!;
    }

    // ---------- Time modes: 15 min · 1 hour · weekend (remembered for the day) ----------
    const MODE_KEY = `plan:mode:${new Date().toLocaleDateString('en-CA')}`;
    const weekendDay = [0, 6].includes(new Date().getDay());
    let mode = (() => { try { return localStorage.getItem(MODE_KEY); } catch { return null; } })() ?? (weekendDay ? 'weekend' : 'hour');
    function applyMode() {
        document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
        let mins = 0;
        document.querySelectorAll<HTMLElement>('.plan-step[data-modes]').forEach(li => {
            const on = li.dataset.modes!.split(' ').includes(mode);
            li.hidden = !on;
            if (on) mins += Number(li.dataset.min ?? 0);
        });
        const t = document.querySelector('[data-plan-time]');
        if (t) t.textContent = `about ${mins} min`;
        paintPlan();
    }
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(b => b.addEventListener('click', () => {
        mode = b.dataset.mode!;
        try { localStorage.setItem(MODE_KEY, mode); } catch {}
        applyMode();
    }));

    // ---------- Rabbit hole: keep today's, else the best topic you haven't learned or seen ----------
    {
        const today = new Date().toLocaleDateString('en-CA');
        const KEY = 'rabbit:shown';
        let shown: Record<string, string> = {};
        try { shown = JSON.parse(localStorage.getItem(KEY) ?? '{}'); } catch {}
        const learned = getSet('learned');
        const holes = [...document.querySelectorAll<HTMLElement>('[data-hole]')];
        const id = (h: HTMLElement) => h.dataset.hole!;
        const pick = holes.find(h => shown[id(h)] === today)
            ?? holes.find(h => !learned.has(id(h)) && !shown[id(h)])
            ?? holes.find(h => !learned.has(id(h)))
            ?? holes[0];
        if (pick) {
            holes.forEach(h => (h.hidden = h !== pick));
            shown[id(pick)] ??= today;
            try { localStorage.setItem(KEY, JSON.stringify(shown)); } catch {}
        }
    }

    let done = readSet(key);
    const boxes = document.querySelectorAll<HTMLInputElement>('[data-plan-step]');
    const visibleBoxes = () => [...boxes].filter(b => !b.closest('li')?.hidden);
    function paintPlan() {
        boxes.forEach(b => { b.checked = done.has(b.dataset.planStep!); b.closest('li')?.classList.toggle('is-done', b.checked); });
        const vis = visibleBoxes();
        const all = vis.length > 0 && vis.every(b => b.checked);
        document.querySelector<HTMLElement>('[data-plan-done]')!.hidden = !all;
        document.querySelector('[data-plan]')?.classList.toggle('is-complete', all);
    }
    boxes.forEach(b => b.addEventListener('change', () => {
        b.checked ? done.add(b.dataset.planStep!) : done.delete(b.dataset.planStep!);
        try { localStorage.setItem(key, JSON.stringify([...done])); } catch {}
        paintPlan();
        mountReadingStats();
    }));
    applyMode();
    mountReadingStats();
</script>
