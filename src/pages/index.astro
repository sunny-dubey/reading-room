---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import LearnCard from '../components/LearnCard.astro';
import ReadingMast from '../components/ReadingMast.astro';
import ReadingClient from '../components/ReadingClient.astro';
import { getReading, getCanon, getRevisit } from '../lib/reading';

const { learning, fetchedAt, now, deepRead, picks, postmortem, tracks, pulse, startups } = await getReading();
const canon = await getCanon();
const revisit = await getRevisit(now);
const today = fetchedAt.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
const deepCount = tracks.reduce((a, t) => a + t.deep.length, 0);
const hours = (m: number) => m >= 90 ? `${Math.round(m / 60)} h` : `${m} min`;
const dev = import.meta.env.DEV;

// ---------- Today's plan: read → canon → explain/revisit ----------
const canonPlan = canon.filter(t => t.items.length).map(t => ({
    track: t.short, cat: t.id,
    items: t.items.map(c => ({ id: c.id, title: c.data.title, url: c.data.url, minutes: c.data.minutes })),
}));
const revisitItem = revisit.week[0] ?? revisit.month[0] ?? revisit.archive;
const planMinutes = (deepRead?.brief?.minutes ?? 15) + 25 + 10;
const explainLocal = deepRead ? `${u('/write/')}?title=${encodeURIComponent(deepRead.title)}&ref=${encodeURIComponent(deepRead.link)}` : u('/write/');
---
<Base description="Learn something real every day: distributed systems, backend, AI engineering and ML foundations." accent="reading">
    <div class="rd">
        <ReadingMast title="The Reading Room" kicker={today} sub="Become a sharper engineer: read deeply, explain it back, revisit." updated={fetchedAt} />

        <section class="plan" data-plan>
            <header class="plan-head">
                <h2>Today's plan</h2>
                <span class="plan-time">about {planMinutes} min</span>
            </header>
            <ol class="plan-steps" role="list">
                {deepRead && (
                    <li class="plan-step" data-step="read" data-link={deepRead.link}>
                        <label class="plan-check"><input type="checkbox" data-plan-step="read" aria-label="Done: read" /><span></span></label>
                        <div>
                            <span class="plan-kind">1 · Read deeply</span>
                            <a class="plan-title" href={deepRead.link} target="_blank" rel="noopener noreferrer" data-read>{deepRead.title}</a>
                            <span class="plan-meta">{deepRead.feedTitle}{deepRead.brief?.minutes ? ` · ${deepRead.brief.minutes} min` : ''}{deepRead.skill ? ` · builds ${deepRead.skill.topic.name}` : ''}</span>
                        </div>
                    </li>
                )}
                <li class="plan-step" data-step="canon">
                    <label class="plan-check"><input type="checkbox" data-plan-step="canon" aria-label="Done: canon" /><span></span></label>
                    <div>
                        <span class="plan-kind">2 · A foundation (the Canon)</span>
                        <a class="plan-title" data-plan-canon href={u('/canon/')} target="_blank" rel="noopener noreferrer">Next foundational read</a>
                        <span class="plan-meta" data-plan-canon-meta>Read 25 minutes of it; it doesn't have to be finished today</span>
                    </div>
                </li>
                <li class="plan-step" data-step="explain">
                    <label class="plan-check"><input type="checkbox" data-plan-step="explain" aria-label="Done: explain or revisit" /><span></span></label>
                    <div>
                        {revisitItem ? (
                            <>
                                <span class="plan-kind">3 · Revisit what you wrote</span>
                                <a class="plan-title" href={u(revisitItem.href)}>{revisitItem.title}</a>
                                <span class="plan-meta">Re-read it, then fix or extend it. Revisiting is what makes knowledge stick.</span>
                            </>
                        ) : (
                            <>
                                <span class="plan-kind">3 · Explain it back</span>
                                {dev
                                    ? <a class="plan-title" href={explainLocal}>Explain today's read in your own words</a>
                                    : <a class="plan-title" href="#" data-gh-explain data-title={deepRead?.title ?? 'Today'} data-url={deepRead?.link ?? ''} target="_blank" rel="noopener">Explain today's read in your own words</a>}
                                <span class="plan-meta">10 minutes. If you can explain it simply, you understand it.</span>
                            </>
                        )}
                    </div>
                </li>
            </ol>
            <p class="plan-done" data-plan-done hidden>Done for today ✓ That's a real step forward. Come back tomorrow.</p>
            <script type="application/json" id="plan-canon" set:html={JSON.stringify(canonPlan)} />
        </section>

        {deepRead && (
            <section class="today-hero" data-cat={deepRead.category}>
                <div class="today-label"><span aria-hidden="true">◆</span> Today's deep read</div>
                <LearnCard i={deepRead} size="hero" />
            </section>
        )}

        <section class="home-block">
            <header class="block-head">
                <h2>Continue the Canon</h2>
                <a href={u('/canon/')}>All tracks →</a>
            </header>
            <div class="next-grid">
                {canon.filter(t => t.items.length).map(t => (
                    <div class="next-card" data-next-track={t.id} data-cat={t.id}>
                        <div class="next-top">
                            <a class="story-cat" data-cat={t.id} href={u(`/${t.slug}/#canon`)}>{t.short}</a>
                            <span class="next-progress" data-next-progress></span>
                        </div>
                        {t.items.map(c => (
                            <div class="next-item" data-next-id={c.id} data-link={c.data.url} hidden>
                                <a class="next-title" href={c.data.url} target="_blank" rel="noopener noreferrer" data-read>{c.data.title}</a>
                                <p class="next-why">{c.data.why}</p>
                                <div class="next-foot">
                                    <span>{c.data.author} · {c.data.kind} · {hours(c.data.minutes)}</span>
                                    <button type="button" class="mark-done" data-mark-done={c.id}>Mark done ✓</button>
                                </div>
                            </div>
                        ))}
                        <p class="next-item" data-next-done hidden>Track complete. Go deeper with the fresh reads in <a class="u" href={u(`/${t.slug}/`)}>{t.short}</a>.</p>
                    </div>
                ))}
            </div>
        </section>

        {picks.length > 0 && (
            <section class="home-block">
                <header class="block-head">
                    <h2>More worth your time</h2>
                    <span class="dim">ranked by depth, not recency</span>
                </header>
                <div class="pick-grid">{picks.map(i => <LearnCard i={i} />)}</div>
            </section>
        )}

        <div class="home-split">
            {postmortem && (
                <section class="home-block">
                    <header class="block-head">
                        <h2>Learn from failure</h2>
                        <a href={u('/postmortems/')}>More postmortems →</a>
                    </header>
                    <LearnCard i={postmortem} size="card" showTrack={false} />
                </section>
            )}
            <section class="home-block">
                <header class="block-head">
                    <h2>Revisit</h2>
                    <a href={u('/notebook/')}>Notebook →</a>
                </header>
                <div class="revisit">
                    {revisit.week.length + revisit.month.length === 0 && !revisit.archive ? (
                        <p class="dim">
                            Things you write show up here again after a week and a month, because revisiting is what makes knowledge stick.
                            {dev ? <> Start with <strong>Explain it back</strong> on anything you read.</> : ''}
                        </p>
                    ) : (
                        <ul class="mini" role="list">
                            {revisit.week.map(e => <li><a href={u(e.href)}><span class="mini-title">{e.title}</span><span class="mini-meta">1 week ago</span></a></li>)}
                            {revisit.month.map(e => <li><a href={u(e.href)}><span class="mini-title">{e.title}</span><span class="mini-meta">1 month ago</span></a></li>)}
                            {revisit.archive && <li><a href={u(revisit.archive.href)}><span class="mini-title">{revisit.archive.title}</span><span class="mini-meta">from the archive</span></a></li>}
                        </ul>
                    )}
                </div>
            </section>
        </div>

        <section class="home-block">
            <header class="block-head"><h2>Tracks</h2></header>
            <div class="track-grid">
                {tracks.map(t => (
                    <a class="track-card" href={u(`/${t.slug}/`)} data-cat={t.id}>
                        <span class="track-name"><span class="cat-dot" data-cat={t.id}></span>{t.label}</span>
                        <span class="track-blurb">{t.blurb}</span>
                        <span class="track-stats">{t.deep.length} deep reads · {canon.find(c => c.id === t.id)?.items.length ?? 0} canon</span>
                    </a>
                ))}
            </div>
        </section>

        {startups.launches.length > 0 && (
            <a class="pulse-strip" href={u('/startups/')}>
                <span class="pulse-label">Startups</span>
                <span class="pulse-text">{startups.launches.length} recent YC launches, plus Show HN and Product Hunt. See what's being built.</span>
                <span aria-hidden="true">→</span>
            </a>
        )}
        {pulse.length > 0 && (
            <a class="pulse-strip" href={u('/pulse/')}>
                <span class="pulse-label">Pulse</span>
                <span class="pulse-text">The week in tech, in ten headlines. Glance, then get back to learning.</span>
                <span aria-hidden="true">→</span>
            </a>
        )}
    </div>
    <ReadingClient />
</Base>

<script>
    import { getSet } from '../lib/progress-client';
    // Today's plan: pick the next unfinished Canon item, rotating through tracks day by day,
    // and remember today's ticks (reset tomorrow).
    const key = `plan:${new Date().toLocaleDateString('en-CA')}`;
    const readSet = (k: string) => { try { return new Set<string>(JSON.parse(localStorage.getItem(k) ?? '[]')); } catch { return new Set<string>(); } };
    const plan = JSON.parse(document.getElementById('plan-canon')?.textContent ?? '[]') as { track: string; cat: string; items: { id: string; title: string; url: string; minutes: number }[] }[];
    const canonDone = getSet('canon');
    const open = plan.filter(t => t.items.some(c => !canonDone.has(c.id)));
    const day = Math.floor(Date.now() / 864e5);
    const pickTrack = open.length ? open[day % open.length] : null;
    const next = pickTrack?.items.find(c => !canonDone.has(c.id));
    const link = document.querySelector<HTMLAnchorElement>('[data-plan-canon]');
    const meta = document.querySelector<HTMLElement>('[data-plan-canon-meta]');
    if (next && link && meta) {
        link.href = next.url;
        link.textContent = next.title;
        const t = next.minutes > 60 ? `${Math.round(next.minutes / 60)} h total, read 25 minutes of it today` : `${next.minutes} min`;
        meta.textContent = `${pickTrack!.track} · ${t}`;
        link.closest('li')?.setAttribute('data-link', next.url);
    }

    let done = readSet(key);
    const boxes = document.querySelectorAll<HTMLInputElement>('[data-plan-step]');
    function paintPlan() {
        boxes.forEach(b => { b.checked = done.has(b.dataset.planStep!); b.closest('li')?.classList.toggle('is-done', b.checked); });
        const all = boxes.length > 0 && [...boxes].every(b => b.checked);
        document.querySelector<HTMLElement>('[data-plan-done]')!.hidden = !all;
        document.querySelector('[data-plan]')?.classList.toggle('is-complete', all);
    }
    boxes.forEach(b => b.addEventListener('change', () => {
        b.checked ? done.add(b.dataset.planStep!) : done.delete(b.dataset.planStep!);
        try { localStorage.setItem(key, JSON.stringify([...done])); } catch {}
        paintPlan();
    }));
    paintPlan();
</script>
