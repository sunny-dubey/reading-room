---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Story from '../components/Story.astro';
import Cover from '../components/Cover.astro';
import Thumb from '../components/Thumb.astro';
import { categoryShort } from '../lib/feeds';
import { editionName, istTime, istDate } from '../lib/edition';
import ReadingClient from '../components/ReadingClient.astro';
import { getReading, getCanon, getRevisit, rank, isDeep } from '../lib/reading';
import { getToday } from '../lib/today';
import { getOutages, fmtDuration, internetWeather } from '../lib/outages';
import { getBriefing } from '../lib/briefing';
import OutageMap from '../components/OutageMap.astro';
import MarketTicker from '../components/MarketTicker.astro';
import PuzzleCard from '../components/PuzzleCard.astro';
import NumbersCard from '../components/NumbersCard.astro';
import IncidentDrill from '../components/IncidentDrill.astro';
import PuzzleClient from '../components/PuzzleClient.astro';
import { getPuzzles } from '../lib/puzzles';
import { getWebPuzzles, todaysPicks } from '../lib/web-puzzles';
import WebPuzzleList from '../components/WebPuzzleList.astro';

const { learning, fetchedAt, now, deepRead, deepCands, fresh, picks, desks, wire, topStories, postmortem, tracks, pulse, startups, roadmap } = await getReading();
const canon = await getCanon();
const { question, rabbitHoles, twoTakes, quickCands, explainer, readMap } = await getToday();
const STEP_NAMES = ['Start here', 'Go deeper', 'Master it'];
const ROMAN = ['I', 'II', 'III'];
const pz = await getPuzzles();
const bf = await getBriefing();
const webPicks = todaysPicks(await getWebPuzzles(), now);
const bfDay = (t: number) => new Date(t).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const bfJobs = bf.jobs.filter(j => j.score >= 3 && (j.remoteAnywhere || j.india)).slice(0, 5);
// Outage map panel: the last 72 hours (a week if it's been quiet).
const outages = await getOutages();
const recentOut = (h: number) => outages.incidents.filter(i => outages.now - i.start < h * 3600e3);
const outWindow = recentOut(72).length >= 3 ? 72 : 168;
const outShown = recentOut(outWindow);
const wx = internetWeather(outages.incidents, outages.now);
const outAnchor = (id: string) => `inc-${id.replace(/[^a-z0-9]+/gi, '-')}`;
const issue = Math.floor((+fetchedAt - Date.UTC(2026, 10, 17)) / 864e5) + 1; // No. 1 = the site's first day
const mins = (m?: number) => (m ? `${m} min` : '');
const revisit = await getRevisit(now);
const today = fetchedAt.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
const deepCount = tracks.reduce((a, t) => a + t.deep.length, 0);
const newReads = learning.filter(i => +i.date > +fetchedAt - 6 * 3600e3 && +i.date <= +fetchedAt).length;
const hours = (m: number) => m >= 90 ? `${Math.round(m / 60)} h` : `${m} min`;

const revisitItem = revisit.week[0] ?? revisit.month[0] ?? revisit.archive;

// ---------- This week's design practice (rotates every Monday, IST) ----------
const IST = 5.5 * 3600e3;
const week = Math.floor((now + IST + 3 * 864e5) / (7 * 864e5)); // weeks since epoch, Monday-based
const practice = roadmap.practice.length ? roadmap.practice[week % roadmap.practice.length] : undefined;
// Plus the best recent article that teaches one of the exercise's topics.
const practiceFresh = practice?.topics.flatMap(t => roadmap.itemsByTopic.get(t.id) ?? [])
    .filter(i => isDeep(i) && (i.skill?.sim ?? 0) >= 0.5)
    .sort((a, b) => rank(b, now) - rank(a, now))[0];
---
<Base description="Learn something real every day: distributed systems, architecture, AI engineering, ML, security and maths." accent="reading">
    <div class="rd fp">
        <!-- ===== Masthead ===== -->
        <header class="fp-mast">
            <h1 class="fp-title">The Reading Room</h1>
            <p class="fp-for">A daily paper for engineers who read like researchers: CS research, distributed systems, system design, agentic AI, security, quant finance, macro, applied maths and puzzles. The latest from the best experts in each, informative over opinion.</p>
            <div class="fp-dateline">
                <span>No. {issue}</span>
                <span data-edition-date={fetchedAt.toISOString()}>{istDate(fetchedAt)}</span>
                <span>{editionName(fetchedAt)} edition · <time data-edition-time datetime={fetchedAt.toISOString()}>{istTime(fetchedAt)}</time></span>
            </div>
            <p class="fp-stale" data-stale={fetchedAt.toISOString()} hidden></p>
            <p class="fp-since" data-since hidden></p>
        </header>
        <MarketTicker />




        <!-- ===== Front: the lead story and the wire ===== -->
        <section class="fp-front">
            {deepRead && (
                <div class="fp-lead-wrap">
                    {deepCands.map((d, n) => (
                        <article class="fp-lead" data-deep-lead={d.link} data-link={d.link} data-cat={d.category} hidden={n > 0}>
                            <p class="fp-kicker">The deep read · {categoryShort(d.category)} · {mins(d.brief?.minutes)}</p>
                            <h2 class:list={["fp-lead-h", { long: d.title.length > 60 }]}><a href={d.link} target="_blank" rel="noopener noreferrer" data-read>{d.title}</a></h2>
                            {d.meta?.description && <p class="fp-dek" title="The author's own description">{d.meta.description}</p>}
                            {d.skill && <p class="fp-deck">You'll get better at <a href={u(`/roadmap/#${d.skill.topic.id}`)}>{d.skill.topic.name}</a>. {d.skill.topic.why}</p>}
                            <p class="fp-byline">By {d.feedTitle}</p>
                            <a href={d.link} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><Thumb i={d} w={760} h={280} class="fp-lead-art" eager={n === 0} /></a>
                            {d.classic && <p class="fp-footnote"><span>Builds on a classic</span><a href={d.classic.url} target="_blank" rel="noopener noreferrer">{d.classic.title}</a>, {d.classic.author}</p>}
                        </article>
                    ))}
                    {topStories.length > 0 && (
                        <div class="top-stories">
                            <h3 class="fp-box-h">Top stories</h3>
                            <div class="top-grid">{topStories.map(i => <Story i={i} cover deck={false} />)}</div>
                        </div>
                    )}
                </div>
            )}

            <aside class="fp-side">
                <section class="fp-box wire" aria-label="The wire">
                    <h3 class="fp-box-h">The wire <span class="web-note">newest first, every desk</span></h3>
                    <ol class="wire-list" role="list">
                        {wire.map(i => (
                            <li data-link={i.link} data-cat={i.category} data-ts={+i.date}>
                                <span class="wire-meta"><span class="new-badge" data-new hidden>New</span><span class="cat-dot" data-cat={i.category}></span><time data-rel datetime={i.date.toISOString()}></time> · {categoryShort(i.category)}</span>
                                <a href={i.link} target="_blank" rel="noopener noreferrer" data-read>{i.title}</a>
                                <span class="wire-src">{i.feedTitle}{i.brief?.minutes ? ` · ${i.brief.minutes} min` : ''}</span>
                            </li>
                        ))}
                    </ol>
                </section>

                {question && (
                    <section class="fp-box qotd">
                        <h3 class="fp-box-h">Question of the day</h3>
                        <p class="qotd-q">{question.q}</p>
                        {question.hint && <details class="qotd-hint"><summary>Need a hint?</summary><p>{question.hint}</p></details>}
                        {(question.canon || question.read || question.topic) && (
                            <p class="qotd-reads"><span>Find the answer in</span>
                                {question.canon && <a href={question.canon.data.url} target="_blank" rel="noopener noreferrer">{question.canon.data.title}</a>}
                                {question.read && <a href={question.read.link} target="_blank" rel="noopener noreferrer">{question.read.title}</a>}
                                {question.topic && <a href={u(`/roadmap/#${question.topic.id}`)}>{question.topic.name} on the Roadmap</a>}
                            </p>
                        )}
                    </section>
                )}

            </aside>
        </section>

        <!-- ===== Latest from every desk ===== -->
        <section class="fp-band reveal">
            <h2 class="fp-band-h"><span>Latest from every desk</span></h2>
            <details class="desk-pick">
                <summary>Choose desks <span data-desk-count></span></summary>
                <div class="desk-pick-row" role="group" aria-label="Desks to show">
                    {desks.map(d => (
                        <button type="button" class="desk-chip" data-desk-toggle={d.id} aria-pressed="true"><span class="cat-dot" data-cat={d.id}></span>{d.short}</button>
                    ))}
                    <button type="button" class="desk-chip all" data-desk-all>Show all</button>
                </div>
                <p class="desk-pick-note">Hidden desks also leave the wire and top stories. Saved in this browser only.</p>
            </details>
            <div class="desks">
                {desks.map(d => (
                    <section class="desk" data-cat={d.id}>
                        <h3 class="desk-h"><a href={u(`/${d.slug}/`)}><span class="cat-dot" data-cat={d.id}></span>{d.short}</a></h3>
                        {d.items.map((i, n) => (
                            <article class:list={['desk-item', { first: n === 0 }]} data-link={i.link} data-ts={+i.date} data-story>
                                {n === 0 && <a href={i.link} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><Thumb i={i} w={360} h={110} /></a>}
                                <p class="desk-meta"><span class="new-badge" data-new hidden>New</span><time data-rel datetime={i.date.toISOString()}></time>{i.brief?.minutes ? ` · ${i.brief.minutes} min` : ''}{i.brief?.depth === 'deep' ? ' · deep dive' : ''}</p>
                                <a class="desk-title" href={i.link} target="_blank" rel="noopener noreferrer" data-read>{i.title}</a>
                                {n === 0 && i.meta?.description && <p class="desk-dek">{i.meta.description}</p>}
                                <span class="desk-src">{i.feedTitle}</span>
                            </article>
                        ))}
                    </section>
                ))}
            </div>
        </section>

        <!-- ===== The briefing ===== -->
        <section class="fp-band reveal bf-front">
            <h2 class="fp-band-h"><span>The briefing</span></h2>
            <div class="bf-boxes">
                <div class="bf-box">
                    <h3 class="fp-box-h"><a href={u('/briefing/#releases')}>Release radar</a></h3>
                    <ul role="list">{bf.releases.slice(0, 6).map(r => <li><b>{r.product}</b> <span class="mono">{r.version}</span>{r.newCycle && <span class="bf-tag new">new</span>}<span class="bf-date">{bfDay(r.date)}</span></li>)}</ul>
                </div>
                <div class="bf-box">
                    <h3 class="fp-box-h"><a href={u('/briefing/#eol')}>Obituaries</a></h3>
                    <ul role="list">{bf.eols.filter(e => e.days >= -14).slice(0, 6).map(e => <li class:list={{ dead: e.days < 0 }}><b>{e.product} {e.cycle}</b><span class="bf-date">{e.days < 0 ? `died ${-e.days}d ago` : e.days === 0 ? 'dies today' : `dies in ${e.days}d`}</span></li>)}</ul>
                </div>
                <div class="bf-box">
                    <h3 class="fp-box-h"><a href={u('/briefing/#cves')}>CVE watch · exploited now</a></h3>
                    <ul role="list">{bf.cves.slice(0, 5).map(c => <li class:list={{ mine: c.mine }}><b>{c.vendor} {c.product}</b>{c.ransomware && <span class="bf-tag ransom">ransomware</span>}<span class="bf-date">{bfDay(c.added)}</span></li>)}</ul>
                </div>
                <div class="bf-box">
                    <h3 class="fp-box-h"><a href={u('/briefing/#papers')}>Paper drop</a></h3>
                    <ul role="list">{bf.papers.slice(0, 4).map(p => <li><a href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a><span class="bf-date">{p.topic?.name}</span></li>)}</ul>
                </div>
                <div class="bf-box">
                    <h3 class="fp-box-h"><a href={u('/briefing/#hiring')}>Classifieds · hiring</a></h3>
                    <ul role="list">{bfJobs.map(j => <li><a href={j.url} target="_blank" rel="noopener noreferrer"><b>{j.company}</b> · {j.role}</a><span class="bf-date">{j.india ? 'India' : 'remote'}{j.tags.length ? ` · ${j.tags.slice(0, 2).join(', ')}` : ''}</span></li>)}</ul>
                </div>
            </div>
        </section>

        <!-- ===== The outage map ===== -->
        {outages.incidents.length > 0 && (
            <section class="fp-band reveal out-front">
                <h2 class="fp-band-h"><span>The outage map</span></h2>
                <div class="out-front-grid">
                    <OutageMap incidents={outShown} now={outages.now} size="small" />
                    <div class="out-front-side">
                        <p class="out-front-stats">
                            <strong>{outages.stats.week}</strong> incidents this week{outages.stats.ongoing ? <> · <strong class="live">{outages.stats.ongoing} ongoing</strong></> : ''}
                            {outages.stats.longest && <> · longest <strong>{fmtDuration(outages.stats.longest.duration)}</strong> ({outages.stats.longest.provider})</>}
                        </p>
                        <ul class="out-latest" role="list">
                            {outShown.slice(0, 4).map(i => (
                                <li class:list={[`sev-${i.severity}`, { ongoing: i.ongoing }]}>
                                    <a href={u(`/outages/#${outAnchor(i.id)}`)}>
                                        <span class="out-latest-t"><b>{i.provider}</b> · {i.title}</span>
                                        <span class="story-by">{i.places[0]?.name ?? 'Global'} · <time data-rel datetime={new Date(i.start).toISOString()}></time>{i.ongoing ? ' · ongoing' : i.duration ? ` · ${fmtDuration(i.duration)}` : ''}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                        {outages.featured && <p class="out-front-inv"><span>Investigation of the week</span><a href={u(`/outages/#${outAnchor(outages.featured.id)}`)}>{outages.featured.provider}: {outages.featured.title}</a></p>}
                        <a class="fp-more" href={u('/outages/')}>Open the full map and every investigation →</a>
                    </div>
                </div>
            </section>
        )}

        <!-- ===== The puzzle page ===== -->
        {pz.today && (
            <section class="fp-band reveal puzzle-band">
                <h2 class="fp-band-h"><span>The puzzle page</span></h2>
                <div class="puzzle-grid">
                    <div class="puzzle-main">
                        <PuzzleCard p={pz.today} featured />
                        {webPicks.length > 0 && (
                            <div class="web-today">
                                <h3 class="fp-box-h">From around the web <span class="web-note">links to the originals, credited</span></h3>
                                <WebPuzzleList rows={webPicks} />
                            </div>
                        )}
                    </div>
                    <div class="puzzle-side">
                        <NumbersCard cards={pz.numbers} />
                        {pz.drill && <IncidentDrill i={pz.drill} />}
                        <a class="fp-more" href={u('/puzzles/')}>All {pz.puzzles.length} puzzles and the full numbers deck →</a>
                    </div>
                </div>
            </section>
        )}

        <!-- ===== Bottom row ===== -->
        <section class="fp-band fp-bottom reveal">
            {postmortem && (
                <div class="fp-cell" data-link={postmortem.link} data-cat="postmortems">
                    <h3 class="fp-box-h">Learn from failure</h3>
                    <a href={postmortem.link} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><Cover seed={postmortem.title} track="postmortems" w={320} h={120} /></a>
                    <a class="fp-cell-h" href={postmortem.link} target="_blank" rel="noopener noreferrer" data-read>{postmortem.title}</a>
                    <p class="story-by">{postmortem.feedTitle}{postmortem.brief?.minutes ? ` · ${postmortem.brief.minutes} min` : ''}</p>
                    <a class="fp-more" href={u('/postmortems/')}>More postmortems →</a>
                </div>
            )}
            {explainer && (
                <div class="fp-cell" data-cat={explainer.track} data-link={explainer.url}>
                    <h3 class="fp-box-h">See it, don't just read it</h3>
                    <a href={explainer.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><Cover seed={explainer.title} track={explainer.track} w={320} h={120} /></a>
                    <a class="fp-cell-h" href={explainer.url} target="_blank" rel="noopener noreferrer" data-read>{explainer.title}</a>
                    <p class="fp-cell-p">{explainer.why}</p>
                    <p class="story-by">{explainer.author} · {explainer.minutes} min · interactive</p>
                </div>
            )}
        </section>

    </div>
    <ReadingClient />
    <PuzzleClient />
</Base>


<script>
    import { getHistory } from '../lib/history-client';

    // ---------- Lead story: keep today's pick all day, else the best one you haven't opened or been shown ----------
    {
        const today = new Date().toLocaleDateString('en-CA');
        const SHOWN = 'plan:deep-shown';
        let shown: Record<string, string> = {};
        try { shown = JSON.parse(localStorage.getItem(SHOWN) ?? '{}'); } catch {}
        const read = new Set(getHistory().map(r => r.u));
        const cands = [...document.querySelectorAll<HTMLElement>('[data-deep-lead]')];
        const link = (c: HTMLElement) => c.dataset.deepLead!;
        const pick = cands.find(c => shown[link(c)] === today)
            ?? cands.find(c => !read.has(link(c)) && !shown[link(c)])
            ?? cands.find(c => !read.has(link(c)))
            ?? cands[0];
        if (pick) {
            cands.forEach(c => (c.hidden = c !== pick));
            shown[link(pick)] ??= today;
            const cutoff = new Date(Date.now() - 60 * 864e5).toLocaleDateString('en-CA');
            for (const [k, d] of Object.entries(shown)) if (d < cutoff) delete shown[k];
            try { localStorage.setItem(SHOWN, JSON.stringify(shown)); } catch {}
            // Don't show the lead twice on the page.
            document.querySelectorAll<HTMLElement>('[data-story], .wire-list li').forEach(el => { if (el.dataset.link === link(pick)) el.hidden = true; });
        }
    }

    // ---------- choose desks: hidden desks are remembered in this browser (localStorage `desks:hidden`) ----------
    {
        const KEY = 'desks:hidden';
        let off = new Set<string>();
        try { off = new Set(JSON.parse(localStorage.getItem(KEY) ?? '[]')); } catch {}
        const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-desk-toggle]')];
        const count = document.querySelector<HTMLElement>('[data-desk-count]');
        const paint = () => {
            chips.forEach(b => b.setAttribute('aria-pressed', String(!off.has(b.dataset.deskToggle!))));
            // Only desk sections, wire items and top stories; the lead stays.
            document.querySelectorAll<HTMLElement>('.desk[data-cat], .wire-list li[data-cat], .top-stories [data-story][data-cat]')
                .forEach(el => el.classList.toggle('desk-off', off.has(el.dataset.cat!)));
            if (count) count.textContent = off.size ? `(${chips.length - off.size} of ${chips.length} shown)` : '';
        };
        const save = () => { try { localStorage.setItem(KEY, JSON.stringify([...off])); } catch {} paint(); };
        chips.forEach(b => b.addEventListener('click', () => {
            const id = b.dataset.deskToggle!;
            if (off.has(id)) off.delete(id);
            else if (off.size < chips.length - 1) off.add(id); // keep at least one desk
            save();
        }));
        document.querySelector('[data-desk-all]')?.addEventListener('click', () => { off.clear(); save(); });
        paint();
    }
</script>
