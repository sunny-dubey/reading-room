---
// The "Thoughts" part of the edition: the full bands for this part (src/components/Edition.astro).
import Base from '../layouts/Base.astro';
import ReadingMast from '../components/ReadingMast.astro';
import ReadingClient from '../components/ReadingClient.astro';
import Edition from '../components/Edition.astro';
import { getReading } from '../lib/reading';
const { fetchedAt } = await getReading();
---
<Base title="Thoughts" description="Essays and opinion, for perspective. Read these last." accent="reading">
    <div class="rd calm">
        <ReadingMast compact title="Thoughts" sub="Essays and opinion, for perspective. Read these last." updated={fetchedAt} />
        <Edition part="thoughts" />
    </div>
    <ReadingClient />
</Base>
