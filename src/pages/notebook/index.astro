---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import { getNotes, getNoteTags, fmtDate } from '../../lib/content';
import { ghNewNote } from '../../lib/site';
const notes = await getNotes();
const tags = await getNoteTags();
const dev = import.meta.env.DEV;
const host = (url?: string) => { try { return url ? new URL(url).hostname.replace(/^www\./, '') : ''; } catch { return ''; } };
---
<Base title="Notebook" description="What I understood from what I read, in my own words." accent="note">
    <div class="narrow">
        <header class="page-head">
            <h1>Notebook <span class="count-pill">{notes.length}</span></h1>
            <p class="lead">What I understood from what I read, in my own words.</p>
            {dev
                ? <a class="btn nb-new" href={u('/write/')}>+ New note</a>
                : <a class="btn nb-new" href={ghNewNote} data-gh-new target="_blank" rel="noopener">+ New note</a>}
        </header>

        {tags.length > 0 && (
            <div class="filters" role="group" aria-label="Filter by tag">
                <button class="filter" data-tag="" aria-pressed="true">All</button>
                {tags.map(([t, n]) => <button class="filter" data-tag={t} aria-pressed="false">#{t} <span class="dim">{n}</span></button>)}
            </div>
        )}

        {notes.length === 0 ? (
            <p class="notice">
                No notes yet. Use <strong>Explain it back</strong> on anything you read: putting it in your own words is where understanding happens.
            </p>
        ) : (
            <ul class="nb-list" role="list">
                {notes.map(n => (
                    <li class="nb-item" data-tags={n.data.tags.join(' ')}>
                        <a class="nb-title" href={u(`/notebook/${n.id}/`)}>{n.data.title}{n.data.draft && <span class="nb-draft">draft</span>}</a>
                        <div class="nb-meta">
                            <time datetime={n.data.date.toISOString()}>{fmtDate(n.data.date)}</time>
                            {n.data.source && <span>on {host(n.data.source)}</span>}
                            {n.data.tags.map(t => <a class="nb-tag" href={`?tag=${t}`}>#{t}</a>)}
                        </div>
                    </li>
                ))}
            </ul>
        )}
    </div>
</Base>
<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter[data-tag]');
    function apply(tag: string) {
        buttons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
        document.querySelectorAll<HTMLElement>('.nb-item').forEach(li => {
            li.hidden = !!tag && !(li.dataset.tags ?? '').split(' ').includes(tag);
        });
    }
    buttons.forEach(b => b.addEventListener('click', () => {
        const tag = b.dataset.tag ?? '';
        history.replaceState(null, '', tag ? `?tag=${tag}` : location.pathname);
        apply(tag);
    }));
    apply(new URLSearchParams(location.search).get('tag') ?? '');
</script>
