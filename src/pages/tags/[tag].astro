---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import ItemList from '../../components/ItemList.astro';
import { getAllItems, getTagCounts } from '../../lib/content';

export async function getStaticPaths() {
    return (await getTagCounts()).map(([tag]) => ({ params: { tag } }));
}
const { tag } = Astro.params;
const items = (await getAllItems()).filter(i => i.tags.includes(tag!));
---
<Base title={`#${tag}`}>
    <header class="page-head">
        <a class="back" href={u('/tags/')}>← topics</a>
        <h1>#{tag}</h1>
        <p class="lead">{items.length} {items.length === 1 ? 'item' : 'items'} across everything.</p>
    </header>
    <ItemList items={items} />
</Base>
