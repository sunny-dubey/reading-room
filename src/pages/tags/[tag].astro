---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import ItemList from '../../components/ItemList.astro';
import { getAllItems, getTagCounts } from '../../lib/content';

export async function getStaticPaths() {
    return (await getTagCounts()).map(([tag]) => ({ params: { tag } }));
}
const { tag } = Astro.params;
const items = (await getAllItems()).filter(i => i.tags.includes(tag!));
---
<Base title={`#${tag}`} accent="note">
    <div class="narrow">
        <header class="page-head">
            <a class="back" href={u('/tags/')}>← Topics</a>
            <h1>#{tag} <span class="count-pill">{items.length}</span></h1>
            <p class="lead">Everything tagged {tag}, across all sections.</p>
        </header>
        <ItemList items={items} />
    </div>
</Base>
