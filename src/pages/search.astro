---
import Base from '../layouts/Base.astro';
---
<Base title="Search">
    <div class="narrow">
        <header class="page-head"><h1>Search</h1><p class="lead">Roadmap topics, the Canon, recent articles, your notes and saved links.</p></header>
        <label class="tile search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input id="q" class="search-input" type="search" placeholder="idempotency, raft, evals, queueing…" autocomplete="off" autofocus aria-label="Search" />
        </label>
        <p id="status"></p>
        <ul id="results" class="rows" role="list"></ul>
    </div>
</Base>
<script>
    type Doc = { kind: string; title: string; href: string; tags: string[]; text: string };
    const input = document.getElementById('q') as HTMLInputElement;
    const list = document.getElementById('results')!;
    const status = document.getElementById('status')!;
    let docs: Doc[] = [];

    const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

    function snippet(text: string, term: string) {
        const i = text.toLowerCase().indexOf(term);
        if (i < 0) return text.slice(0, 140);
        const start = Math.max(0, i - 60);
        return (start ? '…' : '') + text.slice(start, i + 100) + '…';
    }

    function run() {
        const q = input.value.trim().toLowerCase();
        const url = new URL(location.href);
        q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
        history.replaceState(null, '', url);
        if (!q) { list.innerHTML = ''; status.textContent = ''; return; }
        const terms = q.split(/\s+/);
        const scored = docs.map(d => {
            const title = d.title.toLowerCase(), tags = d.tags.join(' '), text = d.text.toLowerCase();
            let score = 0;
            for (const t of terms) {
                if (title.includes(t)) score += 5;
                else if (tags.includes(t)) score += 3;
                else if (text.includes(t)) score += 1;
                else return { d, score: 0 };
            }
            // Topics and foundations first when equally relevant: they're the map, articles are the territory.
            score += ({ topic: 1.5, canon: 1, note: 0.8, saved: 0.5 } as Record<string, number>)[d.kind] ?? 0;
            return { d, score };
        }).filter(x => x.score > 0).sort((a, b) => b.score - a.score);
        status.textContent = `${scored.length} result${scored.length === 1 ? '' : 's'}`;
        list.innerHTML = scored.map(({ d }) => {
            const ext = d.kind !== 'topic' && d.kind !== 'note';
            return `<li class="tile hoverable k-${d.kind}"><div class="row"><span class="kind">${d.kind}</span>
                <a class="row-title stretched" href="${esc(d.href)}"${ext ? ' target="_blank" rel="noopener noreferrer"' : ''}>${esc(d.title)}${ext ? ' ↗' : ''}</a></div>
                <p class="row-blurb">${esc(snippet(d.text, terms[0]))}</p></li>`;
        }).join('');
    }

    fetch(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/search-index.json`).then(r => r.json()).then((data: Doc[]) => {
        docs = data;
        const initial = new URLSearchParams(location.search).get('q');
        if (initial) input.value = initial;
        run();
    });
    input.addEventListener('input', run);
</script>
