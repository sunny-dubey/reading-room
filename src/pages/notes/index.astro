---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { getNotes, fmtDate } from '../../lib/content';
const notes = await getNotes();
---
<Base title="Notes" description="One page per topic, kept up to date." accent="note">
    <header class="page-head">
        <h1>Notes <span class="count-pill">{notes.length}</span></h1>
        <p class="lead">One page per topic, kept up to date. When a topic keeps showing up in the log, it gets a page here.</p>
    </header>
    {notes.length === 0 ? <p class="notice">No notes yet.</p> : (
        <div class="grid">
            {notes.map(n => (
                <article class="tile hoverable k-note">
                    <a class="card-title stretched" href={u(`/notes/${n.id}/`)}>{n.data.title}</a>
                    {n.data.summary && <p class="card-text">{n.data.summary}</p>}
                    <div class="card-foot">
                        <Tags tags={n.data.tags} />
                        <span class="card-date">updated {fmtDate(n.data.updated)}</span>
                    </div>
                </article>
            ))}
        </div>
    )}
</Base>
