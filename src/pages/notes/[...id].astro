---
import { u } from '../../lib/url';
import Entry from '../../layouts/Entry.astro';
import Tile from '../../components/Tile.astro';
import { getNotes, getLog, fmtDate } from '../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
    return (await getNotes()).map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const related = (await getLog()).filter(l => l.data.tags.some(t => entry.data.tags.includes(t))).slice(0, 8);
---
<Entry k="note" edit={{ kind: "note", id: entry.id }} title={entry.data.title} description={entry.data.summary} meta={`updated ${fmtDate(entry.data.updated)}`} tags={entry.data.tags} back={{ href: u('/notes/'), label: 'Notes' }}>
    <Content />
    {related.length > 0 && (
        <div slot="after" class="related">
            <Tile k="log" label="Related log entries">
                <ul class="mini" role="list">
                    {related.map(l => (
                        <li><a href={u(`/log/${l.id}/`)}><span class="mini-title">{l.data.title}</span><span class="mini-meta">{fmtDate(l.data.date)}</span></a></li>
                    ))}
                </ul>
            </Tile>
        </div>
    )}
</Entry>
