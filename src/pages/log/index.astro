---
import { u } from '../../lib/url';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { getLog, fmtMonth } from '../../lib/content';

const entries = await getLog();
const rendered = await Promise.all(entries.map(async e => ({ e, Content: (await render(e)).Content })));
const groups = new Map<string, typeof rendered>();
for (const r of rendered) {
    const key = fmtMonth(r.e.data.date);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key)!.push(r);
}
const day = (d: Date) => d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Log" description="Short, dated things I learned." accent="log">
    <div class="narrow">
        <header class="page-head">
            <h1>Log <span class="count-pill">{entries.length}</span></h1>
            <p class="lead">Short things I learned. Newest first, no schedule.</p>
        </header>
        {entries.length === 0 && <p class="notice">No entries yet.</p>}
        {[...groups].map(([month, rs]) => (
            <section>
                <div class="timeline-month">{month} · {rs.length}</div>
                <div class="log-list">
                    {rs.map(({ e, Content }) => (
                        <article class="tile log-card k-log" id={e.id}>
                            <div class="log-date">
                                <time datetime={e.data.date.toISOString()}>{day(e.data.date)}</time>
                                {e.data.draft && <span class="draft">draft</span>}
                            </div>
                            <h2><a href={u(`/log/${e.id}/`)}>{e.data.title}</a></h2>
                            <div class="prose"><Content /></div>
                            <div class="card-foot">
                                <Tags tags={e.data.tags} />
                            </div>
                        </article>
                    ))}
                </div>
            </section>
        ))}
    </div>
</Base>
