---
import { u } from '../../lib/url';
import Entry from '../../layouts/Entry.astro';
import { getLog, fmtDate } from '../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
    return (await getLog()).map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const meta = [fmtDate(entry.data.date), entry.data.source].filter(Boolean).join(' · ');
---
<Entry title={entry.data.title} meta={meta} tags={entry.data.tags} back={{ href: u('/log/'), label: 'log' }}>
    <Content />
</Entry>
