---
import Base from '../layouts/Base.astro';
import ReadingMast from '../components/ReadingMast.astro';
import ReadingClient from '../components/ReadingClient.astro';
import PuzzleCard from '../components/PuzzleCard.astro';
import PuzzleClient from '../components/PuzzleClient.astro';
import { getPuzzles, TYPE_LABEL, type PuzzleType } from '../lib/puzzles';
import { getWebPuzzles, todaysPicks } from '../lib/web-puzzles';
import WebPuzzleList from '../components/WebPuzzleList.astro';
import { getReading, rank, isDeep } from '../lib/reading';
import { u } from '../lib/url';


const { puzzles, today, numbers, now } = await getPuzzles();
const web = (await getWebPuzzles()).filter(s => s.items.length);
const picks = todaysPicks(web, now);
// The weekly design problem (rotates every Monday, IST).
const { roadmap } = await getReading();
const week = Math.floor((now + 5.5 * 3600e3 + 3 * 864e5) / (7 * 864e5));
const practice = roadmap.practice.length ? roadmap.practice[week % roadmap.practice.length] : undefined;
const practiceFresh = practice?.topics.flatMap(t => roadmap.itemsByTopic.get(t.id) ?? [])
    .filter(i => isDeep(i) && (i.skill?.sim ?? 0) >= 0.5).sort((a, b) => rank(b, now) - rank(a, now))[0];
const types = Object.keys(TYPE_LABEL) as PuzzleType[];
const fmt = (n: number) => (Math.abs(n) >= 1e7 ? n.toExponential(2).replace('e+', ' × 10^') : n.toLocaleString('en-US', { maximumSignificantDigits: 4 }));
---
<Base title="Puzzles" description="Engineering puzzles: spot the bug, back-of-the-envelope estimates, distributed-systems scenarios, interleavings, complexity, and the numbers every engineer should know." accent="reading">
    <div class="rd puzzles-page">
        <ReadingMast compact title="The puzzle page" sub={`${puzzles.length} puzzles, each checked by running the code, enumerating every ordering or showing the arithmetic.`} />
        <p class="pz-solved-line">Solved so far: <strong data-pz-solved>0</strong> of {puzzles.length}<span data-pz-streak></span></p>

        <div class="out-controls" role="group" aria-label="Filter puzzles">
            <div class="out-kinds">
                <button type="button" data-pz-filter="all" aria-pressed="true">All</button>
                {types.map(t => <button type="button" data-pz-filter={t} aria-pressed="false">{TYPE_LABEL[t]} · {puzzles.filter(p => p.type === t).length}</button>)}
                <button type="button" data-pz-filter="unsolved" aria-pressed="false">Unsolved</button>
            </div>
        </div>

        {today && (
            <section class="fp-band">
                <h2 class="fp-band-h"><span>Today's puzzle</span></h2>
                <PuzzleCard p={today} featured />
            </section>
        )}

        {practice && (
            <section class="practice" id="practice" data-practice={`${practice.id}-w${week}`}>
                <div class="practice-head">
                    <span class="practice-label">The weekly problem</span>
                    <label class="practice-done"><input type="checkbox" data-practice-check /> Done</label>
                </div>
                <h2 class="practice-title">{practice.name}</h2>
                {practice.twist && <p class="practice-twist dropcap">{practice.twist}</p>}
                <p class="practice-how">30–45 minutes, on paper or a whiteboard. Work through it in order:</p>
                <ol class="practice-steps">
                    <li><strong>Requirements:</strong> who uses it, what must it do, what must it never do</li>
                    <li><strong>Estimates:</strong> requests per second, data size, read/write ratio</li>
                    <li><strong>API and data model</strong></li>
                    <li><strong>High-level design:</strong> boxes and arrows, the request path end to end</li>
                    <li><strong>Bottlenecks and trade-offs:</strong> what breaks at 10×, what you'd change</li>
                </ol>
                {practice.topics.length > 0 && (
                    <p class="practice-links"><span>Exercises</span>{practice.topics.map(t => <a href={u(`/roadmap/#${t.id}`)}>{t.name}</a>)}</p>
                )}
                {(practice.canon.length > 0 || practiceFresh) && (
                    <p class="practice-links"><span>Read first</span>
                        {practice.canon.map(c => <a href={c.data.url} target="_blank" rel="noopener noreferrer" title={`${c.data.author} · ${c.data.minutes} min`}>{c.data.title}</a>)}
                        {practiceFresh && <a href={practiceFresh.link} target="_blank" rel="noopener noreferrer" title={`New · ${practiceFresh.feedTitle}${practiceFresh.brief?.minutes ? ` · ${practiceFresh.brief.minutes} min` : ''}`}>{practiceFresh.title}</a>}
                    </p>
                )}
            </section>
        )}


        <section class="fp-band" id="web">
            <h2 class="fp-band-h"><span>From around the web</span></h2>
            <p class="side-note">The best puzzle collections online, as links: each opens on the original site, credited to whoever made it. Nothing is copied here. Tick what you've solved; it's saved in this browser only.</p>
            {picks.length > 0 && <div class="web-today"><h3 class="fp-box-h">Today's picks</h3><WebPuzzleList rows={picks} /></div>}
            <div class="web-sources">
                {web.map(s => (
                    <details class="web-source" open={s.items.length <= 12}>
                        <summary>
                            <span class="web-src-name">{s.name}</span>
                            <span class="web-src-meta">by {s.credit} · {s.items.length} {s.items.length === 1 ? 'puzzle' : 'puzzles'} · {s.cadence} · <span data-web-count={s.items.map(i => i.id).join(' ')}></span></span>
                        </summary>
                        <p class="web-src-about">{s.about} <a href={s.home} target="_blank" rel="noopener noreferrer">Open {s.name} ↗</a></p>
                        <WebPuzzleList rows={s.items.map(item => ({ source: s, item }))} compact />
                    </details>
                ))}
            </div>
        </section>

        <section class="fp-band">
            <h2 class="fp-band-h"><span>Every puzzle</span></h2>
            <div class="pz-grid">
                {puzzles.filter(p => p !== today).slice(0, 6).map(p => <PuzzleCard p={p} />)}
            </div>
            {puzzles.filter(p => p !== today).length > 6 && (
                <details class="more-block">
                    <summary>All {puzzles.filter(p => p !== today).length} puzzles</summary>
                    <div class="pz-grid">{puzzles.filter(p => p !== today).slice(6).map(p => <PuzzleCard p={p} />)}</div>
                </details>
            )}
        </section>

        <section class="fp-band" id="numbers">
            <h2 class="fp-band-h"><span>Numbers you should know</span></h2>
            <p class="side-note">The full deck. Today shows one a day; here you can study them all. Cover the right side and test yourself.</p>
            <details class="more-block">
                <summary>Open the deck ({numbers.length} numbers)</summary>
                <dl class="num-deck">
                    {numbers.map(c => (
                        <div><dt>{c.q}</dt><dd><b>{fmt(c.answer)} {c.unit}</b><span>{c.how}</span><em>{c.source}</em></dd></div>
                    ))}
                </dl>
            </details>
        </section>
    </div>
    <ReadingClient />
    <PuzzleClient />
</Base>

<script>
    const results = (() => { try { return JSON.parse(localStorage.getItem('puzzles:results') ?? '{}'); } catch { return {}; } })();
    document.querySelectorAll<HTMLButtonElement>('[data-pz-filter]').forEach(b => b.addEventListener('click', () => {
        const f = b.dataset.pzFilter!;
        document.querySelectorAll('[data-pz-filter]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
        document.querySelectorAll<HTMLElement>('.pz-grid [data-puzzle]').forEach(c => {
            c.hidden = f === 'all' ? false : f === 'unsolved' ? !!results[c.dataset.puzzle!] : c.dataset.type !== f;
        });
    }));
</script>

<script>
    // The weekly problem: a tick per week, kept in this browser.
    const practice = document.querySelector<HTMLElement>('[data-practice]');
    const pcheck = document.querySelector<HTMLInputElement>('[data-practice-check]');
    if (practice && pcheck) {
        const pkey = `practice:${practice.dataset.practice}`;
        const paint = () => practice.classList.toggle('is-done', pcheck.checked);
        try { pcheck.checked = localStorage.getItem(pkey) === '1'; } catch {}
        paint();
        pcheck.addEventListener('change', () => { try { localStorage.setItem(pkey, pcheck.checked ? '1' : '0'); } catch {} paint(); });
    }
</script>
