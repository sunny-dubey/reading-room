---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { getLog, getNotes, getWriting, getLibrary, getTagCounts, fmtDate } from '../lib/content';
const [log, notes, writing, library, tags] = await Promise.all([getLog(), getNotes(), getWriting(), getLibrary(), getTagCounts()]);
const dev = import.meta.env.DEV;
const short = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Notebook" description="What I learn from what I read." accent="note">
    <header class="page-head">
        <h1>Notebook</h1>
        <p class="lead">What I understood from what I read, in my own words. Short explanations, topic notes, and the occasional longer piece.</p>
    </header>
    <div class="nb-grid">
        <Tile class="nb-log" k="log" label="Log" href={u('/log/')} linkLabel={`All ${log.length} →`}>
            {log.length === 0 ? <p class="dim">Nothing logged yet.{dev && <> Hit <strong>Explain it back</strong> on anything you read, or <a class="u" href={u('/write/?kind=log')}>start one</a>.</>}</p> : (
                <ul class="mini" role="list">{log.slice(0, 8).map(e => <li><a href={u(`/log/${e.id}/`)}><span class="mini-title">{e.data.title}</span><span class="mini-meta">{short(e.data.date)}</span></a></li>)}</ul>
            )}
        </Tile>
        <Tile class="nb-notes" k="note" label="Notes" href={u('/notes/')} linkLabel={`All ${notes.length} →`}>
            {notes.length === 0 ? <p class="dim">No topic notes yet.{dev && <> <a class="u" href={u('/write/?kind=note')}>Start one</a>.</>}</p> : (
                <ul class="mini" role="list">{notes.slice(0, 8).map(n => <li><a href={u(`/notes/${n.id}/`)}><span class="mini-title">{n.data.title}</span><span class="mini-meta">upd {short(n.data.updated)}</span>{n.data.summary && <span class="mini-sub">{n.data.summary}</span>}</a></li>)}</ul>
            )}
        </Tile>
        <Tile class="nb-writing" k="writing" label="Writing" href={u('/writing/')} linkLabel={`All ${writing.length} →`}>
            {writing.length === 0 ? <p class="dim">No long-form posts yet.</p> : (
                <ul class="mini" role="list">{writing.slice(0, 5).map(w => <li><a href={u(`/writing/${w.id}/`)}><span class="mini-title">{w.data.title}</span><span class="mini-meta">{short(w.data.date)}</span></a></li>)}</ul>
            )}
        </Tile>
        <Tile class="nb-saved" k="library" label="Saved" href={u('/library/')} linkLabel={`All ${library.length} →`}>
            <ul class="mini" role="list">{library.slice(0, 5).map(l => <li><a href={l.data.url} target="_blank" rel="noopener noreferrer"><span class="mini-title">{l.data.title} ↗</span><span class="mini-sub">{l.data.why}</span></a></li>)}</ul>
        </Tile>
        {tags.length > 0 && (
            <Tile class="nb-topics" k="note" label="Topics" href={u('/tags/')}>
                <div class="tag-cloud">{tags.map(([t, n]) => <a class="tag" href={u(`/tags/${t}/`)}>#{t} <span class="n">{n}</span></a>)}</div>
            </Tile>
        )}
    </div>
</Base>
