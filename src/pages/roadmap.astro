---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import ReadingMast from '../components/ReadingMast.astro';
import ReadingClient from '../components/ReadingClient.astro';
import { getReading, rank } from '../lib/reading';

const { roadmap, now } = await getReading();
const { areas, itemsByTopic, canonByTopic, topicMap, topics } = roadmap;
import { CATEGORIES } from '../lib/feeds';
// Topic map: dots placed by meaning; size = how many reads teach the topic.
const W = 1000, H = 600, PAD = 28;
const dots = topicMap.map(p => {
    const t = topics.get(p.id)!;
    const n = (itemsByTopic.get(p.id)?.length ?? 0) + (canonByTopic.get(p.id)?.length ?? 0);
    return { ...p, t, n, cx: PAD + p.x * (W - 2 * PAD), cy: PAD + p.y * (H - 2 * PAD) };
});
// Label only areas whose topics sit close together, at their centre.
const areaLabels = areas.map(a => {
    const ds = dots.filter(d => d.t.areaId === a.id);
    if (ds.length < 5) return null;
    const cx = ds.reduce((s, d) => s + d.cx, 0) / ds.length, cy = ds.reduce((s, d) => s + d.cy, 0) / ds.length;
    const spread = ds.reduce((s, d) => s + Math.hypot(d.cx - cx, d.cy - cy), 0) / ds.length;
    return spread < 80 ? { title: a.data.title, cx, cy: Math.min(...ds.map(d => d.cy)) - 12, track: a.data.track, n: ds.length } : null;
}).filter(Boolean) as { title: string; cx: number; cy: number; track: string; n: number }[];
// Drop labels that would overlap one already placed (bigger areas win).
const placed: { x0: number; x1: number; y0: number; y1: number }[] = [];
const areaLabelsFit = areaLabels.sort((a, b) => b.n - a.n).filter(l => {
    const w = l.title.length * 7.2, box = { x0: l.cx - w / 2 - 6, x1: l.cx + w / 2 + 6, y0: l.cy - 22, y1: l.cy + 10 };
    if (placed.some(p => box.x0 < p.x1 && box.x1 > p.x0 && box.y0 < p.y1 && box.y1 > p.y0)) return false;
    placed.push(box); return true;
});
const unique = new Set(areas.flatMap(a => a.data.topics.map(t => t.id)));

// Group each area's topics under their sub-headings, keeping order.
const grouped = (topics: typeof areas[number]['data']['topics']) => {
    const out: { group?: string; items: typeof topics }[] = [];
    for (const t of topics) {
        const last = out[out.length - 1];
        if (last && last.group === t.group) last.items.push(t);
        else out.push({ group: t.group, items: [t] });
    }
    return out;
};
const reads = (id: string) => (itemsByTopic.get(id) ?? []).sort((a, b) => rank(b, now) - rank(a, now)).slice(0, 3);
const freshCount = (a: typeof areas[number]) => new Set(a.data.topics.flatMap(t => (itemsByTopic.get(t.id) ?? []).map(i => i.link))).size;
---
<Base title="Roadmap" description="What I'm learning to become an exceptional engineer, topic by topic." accent="reading">
    <div class="rd">
        <ReadingMast compact title="Roadmap" sub={`${areas.length} areas · ${unique.size} topics. Tick what you've learned; every article is matched to the topic it teaches.`}>
            <div class="rm-overall" data-rm-overall>
                <span class="bar"><span data-rm-bar style="width:0%"></span></span>
                <span data-rm-count>0 / {unique.size} learned</span>
            </div>
            <p class="rm-goal"><strong>Final goal:</strong> design scalable applications, build reliable distributed systems, understand large-scale architectures, make strong trade-offs, and design systems used by millions. For AI: understand how AI systems actually work under the hood, from transformers, GPUs and inference to production RAG and agents.</p>
        </ReadingMast>

        {dots.length > 0 && (
            <section class="tmap" data-tmap>
                <header class="tmap-head">
                    <div>
                        <h2>Topic map</h2>
                        <p>Every topic, placed by meaning: neighbours are related ideas. Bigger dots have more to read. Learned topics glow.</p>
                    </div>
                    <div class="tmap-legend" role="group" aria-label="Highlight a track">
                        {CATEGORIES.filter(c => dots.some(d => d.t.track === c.id)).map(c => (
                            <button type="button" data-tmap-track={c.id} aria-pressed="false"><span class="cat-dot" data-cat={c.id}></span>{c.short}</button>
                        ))}
                    </div>
                </header>
                <div class="tmap-frame">
                    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Map of ${dots.length} topics`}>
                        <g class="tmap-labels" aria-hidden="true">
                            {areaLabelsFit.map(l => <text x={l.cx} y={l.cy} data-cat={l.track}>{l.title}</text>)}
                        </g>
                        <g class="tmap-dots">
                            {dots.map(d => (
                                <circle data-map-dot={d.id} data-cat={d.t.track} data-track={d.t.track} cx={d.cx.toFixed(1)} cy={d.cy.toFixed(1)} r={(3 + Math.min(6, Math.sqrt(d.n) * 1.8)).toFixed(1)}
                                    data-name={d.t.name} data-area={d.t.areaTitle} data-n={d.n} tabindex="0" role="link" aria-label={d.t.name} />
                            ))}
                        </g>
                    </svg>
                    <div class="tmap-tip" data-tmap-tip hidden></div>
                </div>
            </section>
        )}

        <nav class="rm-index" aria-label="Areas">
            {areas.map(a => (
                <a href={`#${a.id}`} data-cat={a.data.track} data-rm-area-link={a.id}>
                    <span class="rm-n">{a.data.n}</span>
                    <span class="rm-t">{a.data.title}</span>
                    <span class="rm-mini"><span data-rm-mini={a.id}></span></span>
                </a>
            ))}
        </nav>

        <div class="rm-areas">
            {areas.map(a => (
                <details class="rm-area" id={a.id} data-cat={a.data.track} data-rm-area={a.id}>
                    <summary>
                        <span class="rm-area-n">{a.data.n}</span>
                        <span class="rm-area-main">
                            <span class="rm-area-title">{a.data.title}</span>
                            <span class="rm-area-why">{a.data.why}</span>
                        </span>
                        <span class="rm-area-meta">
                            <span data-rm-area-count>0 / {new Set(a.data.topics.map(t => t.id)).size}</span>
                            {freshCount(a) > 0 && <span class="rm-fresh">{freshCount(a)} fresh {freshCount(a) === 1 ? 'read' : 'reads'}</span>}
                        </span>
                    </summary>
                    <div class="rm-topics">
                        {grouped(a.data.topics).map(g => (
                            <div class="rm-group">
                                {g.group && <h3 class="rm-group-title">{g.group}</h3>}
                                <ul role="list">
                                    {g.items.map(t => {
                                        const r = reads(t.id);
                                        const c = canonByTopic.get(t.id) ?? [];
                                        return (
                                            <li class="rm-topic" id={t.id} data-topic={t.id} data-canon={c.map(x => x.id).join(' ')}>
                                                <label class="rm-check" title="Mark as learned">
                                                    <input type="checkbox" data-learn={t.id} aria-label={`Learned: ${t.name}`} />
                                                    <span class="rm-box"></span>
                                                </label>
                                                <div class="rm-topic-main">
                                                    <span class="rm-topic-name">{t.name}</span>{topics.get(t.id)?.level && <span class:list={['lvl', `lvl-${topics.get(t.id)!.level.toLowerCase()}`]} title="How hard this is to understand">{topics.get(t.id)!.level}</span>}
                                                    {(r.length > 0 || c.length > 0) && (
                                                        <div class="rm-links">
                                                            {c.map(x => <a class="rm-canon" href={x.data.url} target="_blank" rel="noopener noreferrer" title={x.data.why}>Canon: {x.data.title}</a>)}
                                                            {r.map(i => <a class="rm-read" href={i.link} target="_blank" rel="noopener noreferrer" title={`${i.feedTitle}${i.brief?.minutes ? ` · ${i.brief.minutes} min` : ''}`}>{i.title}</a>)}
                                                        </div>
                                                    )}
                                                </div>
                                            </li>
                                        );
                                    })}
                                </ul>
                            </div>
                        ))}
                    </div>
                </details>
            ))}
        </div>
    </div>
    <ReadingClient />
</Base>

<script>
    import { getSet, setProgress } from '../lib/progress-client';
    let learned = getSet('learned');
    const canonDone = getSet('canon');

    function paint() {
        // Topic state: learned (ticked) > in progress (notes, saved, or a finished Canon read) > not started.
        document.querySelectorAll<HTMLElement>('[data-topic]').forEach(li => {
            const id = li.dataset.topic!;
            const isLearned = learned.has(id);
            const started = (li.dataset.canon ?? '').split(' ').some(c => c && canonDone.has(c));
            li.classList.toggle('is-learned', isLearned);
            li.classList.toggle('is-started', !isLearned && started);
            const cb = li.querySelector<HTMLInputElement>('[data-learn]');
            if (cb) cb.checked = isLearned;
        });
        let total = 0, done = 0;
        const seen = new Set<string>();
        document.querySelectorAll<HTMLElement>('[data-rm-area]').forEach(area => {
            const ids = [...new Set([...area.querySelectorAll<HTMLElement>('[data-topic]')].map(x => x.dataset.topic!))];
            const n = ids.filter(id => learned.has(id)).length;
            area.querySelector('[data-rm-area-count]')!.textContent = `${n} / ${ids.length}`;
            const mini = document.querySelector<HTMLElement>(`[data-rm-mini="${area.dataset.rmArea}"]`);
            if (mini) mini.style.width = `${ids.length ? (n / ids.length) * 100 : 0}%`;
            ids.forEach(id => { if (!seen.has(id)) { seen.add(id); total++; if (learned.has(id)) done++; } });
        });
        document.querySelector('[data-rm-count]')!.textContent = `${done} / ${total} learned`;
        document.querySelectorAll<SVGCircleElement>('[data-map-dot]').forEach(c => {
            const id = c.dataset.mapDot!;
            c.classList.toggle('is-learned', learned.has(id));
            c.classList.toggle('is-started', !learned.has(id) && !!document.querySelector(`[data-topic="${id}"].is-started`));
        });
        (document.querySelector('[data-rm-bar]') as HTMLElement).style.width = `${total ? (done / total) * 100 : 0}%`;
    }

    document.addEventListener('change', e => {
        const cb = (e.target as HTMLElement).closest<HTMLInputElement>('[data-learn]');
        if (!cb) return;
        cb.checked ? learned.add(cb.dataset.learn!) : learned.delete(cb.dataset.learn!);
        setProgress('learned', cb.dataset.learn!, cb.checked);
        paint();
    });

    // Deep links: /roadmap/#topic-id or #area-id opens the right area and highlights the topic.
    function openFromHash() {
        const id = decodeURIComponent(location.hash.slice(1));
        if (!id) return;
        const el = document.getElementById(id);
        if (!el) return;
        const area = el.closest('details') ?? (el.tagName === 'DETAILS' ? el : null);
        if (area) (area as HTMLDetailsElement).open = true;
        if (el.classList.contains('rm-topic')) {
            el.classList.add('is-target');
            setTimeout(() => el.classList.remove('is-target'), 2500);
        }
        el.scrollIntoView({ block: 'center' });
    }
    // ---------- Topic map: tooltip, click to open, highlight a track ----------
    const tip = document.querySelector<HTMLElement>('[data-tmap-tip]');
    const frame = document.querySelector<HTMLElement>('.tmap-frame');
    const showTip = (c: SVGCircleElement) => {
        if (!tip || !frame) return;
        const n = Number(c.dataset.n);
        const state = c.classList.contains('is-learned') ? ' · learned ✓' : '';
        tip.innerHTML = '';
        const b = document.createElement('strong'); b.textContent = c.dataset.name!;
        const s = document.createElement('span'); s.textContent = `${c.dataset.area} · ${n ? `${n} ${n === 1 ? 'read' : 'reads'}` : 'nothing to read yet'}${state}`;
        tip.append(b, s);
        const fr = frame.getBoundingClientRect(), cr = c.getBoundingClientRect();
        tip.style.left = `${Math.min(fr.width - 220, Math.max(0, cr.left - fr.left + cr.width / 2 - 110))}px`;
        tip.style.top = `${cr.top - fr.top - 12}px`;
        tip.hidden = false;
    };
    document.querySelectorAll<SVGCircleElement>('[data-map-dot]').forEach(c => {
        c.addEventListener('mouseenter', () => showTip(c));
        c.addEventListener('focus', () => showTip(c));
        c.addEventListener('mouseleave', () => { if (tip) tip.hidden = true; });
        c.addEventListener('blur', () => { if (tip) tip.hidden = true; });
        const go = () => { location.hash = c.dataset.mapDot!; };
        c.addEventListener('click', go);
        c.addEventListener('keydown', e => { if (e.key === 'Enter') go(); });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-tmap-track]').forEach(b => b.addEventListener('click', () => {
        const on = b.getAttribute('aria-pressed') !== 'true';
        document.querySelectorAll('[data-tmap-track]').forEach(x => x.setAttribute('aria-pressed', 'false'));
        b.setAttribute('aria-pressed', String(on));
        document.querySelector('[data-tmap]')?.toggleAttribute('data-focus', on);
        document.querySelectorAll<SVGCircleElement>('[data-map-dot]').forEach(c => c.classList.toggle('is-focus', on && c.dataset.track === b.dataset.tmapTrack));
    }));

    window.addEventListener('hashchange', openFromHash);
    openFromHash();
    paint();
</script>
