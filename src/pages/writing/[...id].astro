---
import { u } from '../../lib/url';
import Entry from '../../layouts/Entry.astro';
import { getWriting, fmtDate } from '../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
    return (await getWriting()).map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Entry k="writing" edit={{ kind: "writing", id: entry.id }} title={entry.data.title} description={entry.data.description} meta={fmtDate(entry.data.date)} tags={entry.data.tags} back={{ href: u('/writing/'), label: 'Writing' }}>
    <Content />
</Entry>
