---
// The "Try it" part of the edition: the full bands for this part (src/components/Edition.astro).
import Base from '../layouts/Base.astro';
import ReadingMast from '../components/ReadingMast.astro';
import ReadingClient from '../components/ReadingClient.astro';
import Edition from '../components/Edition.astro';
import { getReading } from '../lib/reading';
const { fetchedAt } = await getReading();
---
<Base title="Try it" description="Hands-on pieces you can follow along with, benchmarks to learn from, and today’s puzzle." accent="reading">
    <div class="rd calm">
        <ReadingMast compact title="Try it" sub="Hands-on pieces you can follow along with, benchmarks to learn from, and today’s puzzle." updated={fetchedAt} />
        <Edition part="try" />
    </div>
    <ReadingClient />
</Base>
