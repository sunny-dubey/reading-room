---
// Incident lessons: real outages as case studies (stated cause or postmortem), a reliability table per provider,
// and a plain list of everything else. URL stays /outages/ so old links keep working.
import Base from '../layouts/Base.astro';
import ReadingMast from '../components/ReadingMast.astro';
import ReadingClient from '../components/ReadingClient.astro';
import IncidentReport from '../components/IncidentReport.astro';
import { getOutages, fmtDuration, KINDS } from '../lib/outages';
import { u } from '../lib/url';

const { now, incidents, cases, reliability, status, stats } = await getOutages();
const caseIds = new Set(cases.map(i => i.id));
const rest = incidents.filter(i => !caseIds.has(i.id));
const failing = status.filter(s => !s.ok);
const day = (t: number) => new Date(t).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
---
<Base title="Incident lessons" description="Real outages as case studies: what failed, the cause in the provider's words, and how long it took to fix." accent="reading">
    <div class="rd outages">
        <ReadingMast compact title="Incident lessons" sub={`Real outages from ${status.length} public status pages, last 30 days, read as case studies: what failed, the cause in the provider's own words, and how long it took to fix. For live status, use the provider's own page.`} updated={new Date(now)} />

        <div class="out-stats">
            <div><strong>{cases.length}</strong><span>case studies</span></div>
            <div><strong>{incidents.filter(i => i.rca).length}</strong><span>with a postmortem</span></div>
            <div><strong>{stats.explained}</strong><span>of {incidents.length} incidents gave a cause</span></div>
            <div><strong>{stats.ongoing}</strong><span>still open at this edition</span></div>
        </div>

        <section class="fp-band">
            <h2 class="fp-band-h"><span>Case studies</span></h2>
            {cases.length
                ? cases.map((i, n) => <IncidentReport i={i} now={now} open={n === 0} featured={n === 0} />)
                : <p class="out-empty">No incident in the last 30 days came with a stated cause or a postmortem. See the <a href={u('/postmortems/')}>Postmortems desk</a> for older write-ups.</p>}
            <p class="side-note">A case study is a resolved incident with a postmortem, or one where the provider stated the cause and the impact was real (major, or 30+ minutes). At most two per provider.</p>
        </section>

        <section class="fp-band">
            <h2 class="fp-band-h"><span>Reliability, last 30 days</span></h2>
            <div class="out-table-wrap">
                <table class="bf-table out-rel">
                    <thead><tr><th>Provider</th><th>Incidents</th><th>Major</th><th>Typical fix</th><th>Longest</th><th>Cause given</th></tr></thead>
                    <tbody>
                        {reliability.map(r => (
                            <tr>
                                <td><b>{r.provider}</b> <span class="out-kind">{KINDS[r.kind]}</span></td>
                                <td>{r.count}</td>
                                <td>{r.major || '—'}</td>
                                <td>{r.median !== undefined ? fmtDuration(r.median) : '—'}{r.timed && r.timed < r.count ? <span class="out-n" title="incidents with real timings"> ({r.timed} timed)</span> : ''}</td>
                                <td>{r.longest !== undefined ? fmtDuration(r.longest) : '—'}</td>
                                <td>{r.explained}/{r.count}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <p class="side-note">"Typical fix" is the median time from the start of the problem (as the provider stated it, else its first update) to resolved. Incidents posted only after they ended have no real timing and are left out of it. Counts depend on how much each provider reports, so compare carefully.</p>
        </section>

        <section class="fp-band">
            <details class="out-rest">
                <summary>Every other incident ({rest.length})</summary>
                <ul class="out-rest-list" role="list">
                    {rest.map(i => (
                        <li class:list={[`sev-${i.severity}`, { ongoing: i.ongoing }]}>
                            <span class="bf-date">{day(i.start)}</span>
                            <a href={i.url} target="_blank" rel="noopener noreferrer"><b>{i.provider}</b> · {i.title}</a>
                            <span class="bf-date">{i.ongoing ? 'open' : i.duration ? fmtDuration(i.duration) : ''}{i.severity === 'major' ? ' · major' : ''}</span>
                        </li>
                    ))}
                </ul>
            </details>
        </section>

        <section class="fp-band out-sources">
            <h2 class="fp-band-h"><span>Status pages watched</span></h2>
            <ul role="list">
                {status.map(s => <li><span class={s.ok ? 'ok' : 'bad'}></span>{s.name}<span class="n">{s.ok ? s.count : 'unreachable'}</span></li>)}
            </ul>
            <p class="side-note">Facts come from each provider's own status page. Some pages (Cloudflare, Twilio) fill their feed with planned maintenance, so few real incidents reach us from them. {failing.length > 0 && `${failing.length} unreachable this build.`} Sources live in <code>src/content/status-pages.yaml</code>. <a href={u('/postmortems/')}>Postmortems desk →</a></p>
        </section>
    </div>
    <ReadingClient />
</Base>

<script>
    // Local times, and deep links that open a case study.
    document.querySelectorAll<HTMLTimeElement>('time[data-local]').forEach(t => {
        const d = new Date(t.dateTime);
        let s = d.toLocaleString(undefined, { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' });
        if (/GMT[+-]/.test(s)) {
            const alt = new Intl.DateTimeFormat('en-IN', { timeZoneName: 'short' }).formatToParts(d).find(p => p.type === 'timeZoneName')?.value;
            if (alt && !/GMT[+-]/.test(alt)) s = s.replace(/GMT[+-][\d:]+/, alt);
        }
        t.textContent = s;
    });
    function openHash() {
        const el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (el instanceof HTMLDetailsElement) {
            el.open = true;
            el.scrollIntoView({ block: 'start' });
            el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash');
        }
    }
    window.addEventListener('hashchange', openHash);
    openHash();
</script>
