---
import Base from '../layouts/Base.astro';
import ReadingMast from '../components/ReadingMast.astro';
import ReadingClient from '../components/ReadingClient.astro';
import { categoryShort } from '../lib/feeds';
import { getReading } from '../lib/reading';
const { conceptIndex } = await getReading();
---
<Base title="Concepts" description="Every concept the Reading Room's articles cover, with the best reads for each." accent="reading">
    <div class="rd">
        <ReadingMast compact title="Concepts" sub={`${conceptIndex.length} concepts found in this week's reading. Pick one you're shaky on and read three pieces about it.`} />
        <nav class="concept-cloud" aria-label="Concepts">
            {conceptIndex.map(c => <a class="concept" href={`#${c.slug}`}>{c.name} <span class="n">{c.items.length}</span></a>)}
        </nav>
        <div class="concept-sections">
            {conceptIndex.map(c => (
                <section class="concept-section" id={c.slug}>
                    <h2>{c.name} <span class="count-pill">{c.items.length}</span></h2>
                    <ul role="list">
                        {c.items.slice(0, 8).map(i => (
                            <li data-link={i.link}>
                                <a href={i.link} target="_blank" rel="noopener noreferrer" data-read>{i.title}</a>
                                <span class="dim"> · {i.feedTitle} · {categoryShort(i.category)}{i.brief?.minutes ? ` · ${i.brief.minutes} min` : ''}</span>
                            </li>
                        ))}
                    </ul>
                </section>
            ))}
        </div>
    </div>
    <ReadingClient />
</Base>
