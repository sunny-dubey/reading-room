---
import Base from '../layouts/Base.astro';
import ReadingMast from '../components/ReadingMast.astro';
import ReadingClient from '../components/ReadingClient.astro';
import { getBriefing } from '../lib/briefing';
import { u } from '../lib/url';

const b = await getBriefing();
const day = (t: number) => new Date(t).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const when = (d: number) => d === 0 ? 'today' : d > 0 ? `in ${d} ${d === 1 ? 'day' : 'days'}` : `${-d} ${d === -1 ? 'day' : 'days'} ago`;
---
<Base title="The briefing" description="What changed for engineers: releases, end-of-life dates, exploited vulnerabilities, and new papers." accent="reading">
    <div class="rd fp briefing">
        <ReadingMast compact title="The briefing" sub="What changed in the world your code runs in: releases, obituaries, exploited vulnerabilities and new papers. Facts, from public sources, refreshed with every edition." updated={new Date(b.now)} />
        <nav class="bf-index" aria-label="Sections">
            <a href="#releases">Release radar</a><a href="#eol">Obituaries</a><a href="#cves">CVE watch</a><a href="#papers">Paper drop</a><a href={u('/startups/')}>Startups →</a><a href={u('/pulse/')}>Pulse: the week's headlines →</a>
        </nav>

        <div class="bf-two">
            <section class="fp-band" id="releases">
                <h2 class="fp-band-h"><span>Release radar · last 30 days</span></h2>
                <table class="bf-table">
                    <thead><tr><th>Project</th><th>Version</th><th>Released</th></tr></thead>
                    <tbody>
                        {b.releases.map(r => (
                            <tr><td>{r.product}{r.newCycle && <span class="bf-tag new">new major</span>}{r.others > 0 && <span class="bf-date"> +{r.others} older {r.others === 1 ? 'line' : 'lines'}</span>}</td><td class="mono">{r.link ? <a href={r.link} target="_blank" rel="noopener noreferrer">{r.version}</a> : r.version}</td><td>{day(r.date)}</td></tr>
                        ))}
                    </tbody>
                </table>
                <p class="side-note">Watching {b.watched} projects (<code>src/content/stack.yaml</code>), via endoflife.date.</p>
            </section>

            <section class="fp-band" id="eol">
                <h2 class="fp-band-h"><span>Obituaries · end of life</span></h2>
                <table class="bf-table">
                    <thead><tr><th>Version</th><th>End of support</th><th></th></tr></thead>
                    <tbody>
                        {b.eols.map(e => (
                            <tr class:list={{ dead: e.days < 0, soon: e.days >= 0 && e.days <= 30 }}>
                                <td><a href={`https://endoflife.date/${e.slug}`} target="_blank" rel="noopener noreferrer">{e.product} {e.cycle}</a></td>
                                <td>{day(e.date)}</td>
                                <td class="bf-when">{e.days < 0 ? `died ${when(e.days)}` : `dies ${when(e.days)}`}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
                <p class="side-note">Versions whose support ends within 200 days, or ended in the last 45.</p>
            </section>
        </div>

        <section class="fp-band" id="cves">
            <h2 class="fp-band-h"><span>CVE watch · exploited in the wild, last 21 days</span></h2>
            <p class="bf-lede">{b.cves.length} vulnerabilities added to CISA's Known Exploited Vulnerabilities catalogue in three weeks ({b.kevTotal.toLocaleString()} in total). These aren't theoretical: attackers are using them now. Rows marked <span class="bf-tag mine">your stack</span> name a vendor you use.</p>
            <div class="bf-cves">
                {b.cves.map(c => (
                    <details class:list={['bf-cve', { mine: c.mine }]}>
                        <summary>
                            <span class="mono bf-cve-id">{c.id}</span>
                            <span class="bf-cve-name"><b>{c.vendor} {c.product}</b> · {c.name.replace(new RegExp(`^${c.vendor}\\s+(${c.product}\\s+)?`, 'i'), '')}</span>
                            <span class="bf-cve-tags">{c.mine && <span class="bf-tag mine">your stack</span>}{c.ransomware && <span class="bf-tag ransom">ransomware</span>}<span class="bf-date">added {day(c.added)}</span></span>
                        </summary>
                        <p>{c.summary}</p>
                        <p class="bf-meta">Patch deadline for US agencies: {day(c.due)}{c.cwe ? ` · ${c.cwe}` : ''} · <a href={`https://nvd.nist.gov/vuln/detail/${c.id}`} target="_blank" rel="noopener noreferrer">NVD entry →</a></p>
                    </details>
                ))}
            </div>
        </section>

        <section class="fp-band" id="papers">
            <h2 class="fp-band-h"><span>Paper drop · new on arXiv this week</span></h2>
            <p class="bf-lede">The papers closest to your Roadmap out of {b.papersSeen} new ones in {Object.keys(b.cats).length} categories. Read the abstract; open the paper only if it earns it.</p>
            <div class="bf-papers">
                {b.papers.map(p => (
                    <article class="bf-paper">
                        <p class="fp-kicker">{b.cats[p.cat].label} · <a href={u(`/roadmap/#${p.topic!.id}`)}>{p.topic!.name}</a></p>
                        <h3><a href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a></h3>
                        <p class="bf-by">{p.authors.split(',').slice(0, 3).join(',')}{p.authors.split(',').length > 3 ? ' et al.' : ''}</p>
                        <details><summary>Abstract</summary><p>{p.abstract}</p></details>
                    </article>
                ))}
            </div>
        </section>
    </div>
    <ReadingClient />
</Base>
